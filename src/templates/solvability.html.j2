{#
  solvability.html.j2
  One case's solvability page: one section per function of SwapSolvability, in
  the order the build runs them, each explained above its drawing. Rendered by
  render_solvability.write_report with the full record inlined as JSON.

  The build section replays the real algorithm: the browser runs the same
  union-find over the recorded flood regions, and its final counts are checked
  against the ones Python recorded — a mismatch renders in red.
#}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ record.name }} — swap solvability</title>
<style>
{% include "_theme.css" %}
  {# Board palette only — the chrome above comes from the shared theme. The
     full set the shared player's board() uses, same names as report.html.j2. #}
  :root {
    --wall: {{ record.palette.wall }}; --free: {{ record.palette.free }};
    --grid: {{ record.palette.grid }}; --a: {{ record.palette.a }};
    --b: {{ record.palette.b }}; --arrow-a: {{ record.palette.arrow_a }};
    --arrow-b: {{ record.palette.arrow_b }}; --hot: {{ record.palette.hot }};
    --label: {{ record.palette.label }};
  }
  body { padding: 28px 16px; }
  {# The shared player's viewport — the same rules report.html.j2 carries. #}
  .seg { background: var(--card); border: 1px solid var(--line); border-radius: 5px;
         padding: 3px 8px; font-family: ui-monospace, monospace; font-size: 13px; }
  .boardbox { display: inline-block; vertical-align: top; max-width: 100%; }
  .boardbox.wide { display: block; }
  .board { position: relative; width: var(--bw, 100%); height: var(--bh, 420px); max-width: 100%;
           overflow: hidden; resize: both; background: var(--bg); border: 1px solid var(--line);
           border-radius: 6px; cursor: grab; touch-action: none; user-select: none; }
  .board.dragging { cursor: grabbing; }
  .boardbox.wide .board { resize: vertical; }
  .boardzoom { position: absolute; inset: 0; transform-origin: 0 0; will-change: transform; }
  .boardzoom svg { display: block; width: 100%; height: 100%; }
  .zoomctl { display: flex; gap: 4px; align-items: center; margin-top: 4px; font-size: 12px; }
  .zoomctl button { padding: 1px 7px; font-size: 12px; line-height: 1.4; }
  .zoomctl .zpct { min-width: 3.5em; text-align: center; color: var(--muted);
                   font-variant-numeric: tabular-nums; }
  main { max-width: 980px; margin: 0 auto; }
  h1 { font-size: 21px; margin: 0 0 2px; }
  h2 { font-size: 16px; margin: 40px 0 6px; }
  p { max-width: 76ch; margin: 6px 0; }
  .boardbox { margin: 10px 0; }
  .twoboards { display: flex; flex-wrap: wrap; gap: 18px; }
  .twoboards figure { margin: 0; }
  .twoboards figcaption { font-size: 13px; color: var(--muted); margin-top: 4px; }
  svg.flat { max-width: 100%; height: auto; border: 1px solid var(--line); border-radius: 4px; background: var(--free); }
  .boardzoom canvas { display: block; height: 100%; aspect-ratio: 1 / 1; margin: 0 auto; image-rendering: pixelated; }
  .legend { display: flex; flex-wrap: wrap; gap: 14px; margin: 6px 0; color: var(--muted); font-size: 13px; }
  .thumbrow { display: flex; gap: 18px; align-items: flex-start; flex-wrap: wrap; margin: 10px 0; }
  .thumbrow figure { margin: 0; }
  .thumb-label { font-size: 12.5px; color: var(--muted); margin-top: 3px; }
  .badge { display: inline-block; padding: 1px 8px; border-radius: 9px; color: #fff; font-size: 12px; font-weight: 600; }
  .thumbgrid { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin: 4px 0 14px; }
  canvas.thumb { border: 2px solid transparent; border-radius: 3px; image-rendering: pixelated; }
  canvas.thumb.startmark { border-color: #111; }
  canvas.thumb.goalmark { border-color: #111; border-style: dashed; }
  canvas.thumb.rootmark { border-color: #b45309; }
  .chainrow { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin: 10px 0; }
  .chainrow figure { margin: 0; }
  .chainlabel { min-width: 56px; font-weight: 600; }
  .arrow { font-size: 20px; color: var(--muted); }
  .slotno { font-size: 11px; color: var(--muted); text-align: center; margin-top: 2px; }
  .islandhead { margin: 16px 0 2px; font-weight: 600; }
  .trailwrap { display: flex; gap: 18px; align-items: flex-start; flex-wrap: wrap; }
  .trailwrap .boardbox { flex: 0 1 auto; }
  .trailwrap ol { flex: 1 1 280px; min-width: 260px; margin: 10px 0; max-height: 520px; overflow-y: auto; padding-right: 8px; }
  .trailwrap li.now { color: var(--ink); font-weight: 600; }
</style>
</head>
<body>
<main>
  <h1>{{ record.name }}</h1>
  <p class="muted">{{ record.grid.rows }} &times; {{ record.grid.cols }} grid,
  {{ record.n }}&times;{{ record.n }} robots &middot;
  <a href="../index.html">all cases</a></p>

  <table class="stats">
    <tr>
      <th>Existing solver, <code>bfs_mirror</code></th>
      <td>
        {% if record.solver.solvable %}
        swap possible, minimum {{ record.solver.switches }} control switches
        {% else %}
        swap impossible
        {% endif %}
      </td>
      <td class="num">{{ record.solver.cold_seconds | seconds }} cold,
          {{ record.solver.warm_seconds | seconds }} warm</td>
    </tr>
    <tr>
      <th><code>SwapSolvability</code></th>
      <td>
        {% if record.map.solvable == record.solver.solvable %}
        <span class="ok">{{ 'swap possible' if record.map.solvable else 'swap impossible' }} — agrees</span>
        {% else %}
        <span class="bad">{{ 'swap possible' if record.map.solvable else 'swap impossible' }} — DISAGREES with the solver</span>
        {% endif %}
      </td>
      <td class="num">{{ record.map.build_seconds | seconds }} to build,
          {{ record.map.floods }} flood fills, shortest path
          <span id="stat-path-ms">&mdash;</span></td>
    </tr>
    <tr>
      <th>State space</th>
      <td colspan="2" class="num">{{ record.map.placements }} placements &middot;
        {{ record.map.states | thousands }} states &middot;
        {{ record.map.solvable_starts | thousands }} starts can swap &middot;
        {{ record.map.swap_combinations | thousands }} swap combinations for this start
        &middot; <span id="stat-islands"></span>
      </td>
    </tr>
  </table>

  <h2>1 &middot; <code>for_workspace</code> / <code>__init__</code> — read the board</h2>
  <p>Input: grid shape, free cells, robot size. Dark = wall, white dot =
  interior hole; the robots sit at the test's start.</p>
  <div class="boardbox" id="board-read"></div>

  <h2>2 &middot; <code>erode_window({{ record.n }})</code> — every place a robot fits</h2>
  <p>One erosion answers every corner at once: a dark dot = the whole
  {{ record.n }}&times;{{ record.n }} square sits on free cells.
  {{ record.map.placements }} here. Hover a dot for coordinates.</p>
  <div class="boardbox" id="board-fit"></div>

  <h2>3 &middot; <code>_build</code> — park each placement, flood, join</h2>
  <p>Each placement is visited once as the <em>parked</em> robot (grey). Red
  &times; = would overlap it (touching is fine). Each flood region gets one
  colour; the other robot slides freely inside it. Every member is union-joined
  to the region's first — once with the parked robot as B, once as A. Watch the
  island count fall.</p>
  <div class="controls">
    <button id="step-prev">&larr; prev</button>
    <input type="range" id="step-range" min="0" value="0">
    <button id="step-next">next &rarr;</button>
    <button id="step-end">to the end</button>
  </div>
  <div class="readout" id="step-readout"></div>
  <div class="legend">
    <span><span class="chip" style="background:#374151"></span>parked robot</span>
    <span><span class="chip" style="background:#fca5a5"></span>excluded: would overlap</span>
    <span><span class="chip" style="background:#2563eb"></span><span class="chip" style="background:#d97706"></span>flood regions</span>
  </div>
  <div class="boardbox" id="board-build"></div>
  <p><strong>The state matrix.</strong> Not the board — the plane of
  situations. y &darr; = robot A's corner, x &rarr; = robot B's corner, reading
  order. One square = one photo: A at the row's corner, B at the column's.
  Hover any square for its exact coordinates.</p>
  <div class="legend">
    <span><span class="chip" style="background:{{ record.palette.wall }}"></span>
      robot on a wall — not a situation</span>
    <span><span class="chip" style="background:#e5e7eb"></span>
      robots overlap — not a situation (grey &times;)</span>
  </div>
  <p><b>island</b>: one colour = one group; start and goal one colour =
  solvable. <b>switches</b>: the number in each square — blue near, red far,
  slashed near-black unreachable. <b>sweep</b>: the walk replayed — one
  straight line per run, +1 switch per turn; a run lights only what the mover
  can really walk to, the parked robot can cut its line short.</p>
  <div class="controls">
    <span class="muted">colour the squares by:</span>
    <button class="mx-mode" data-mx="island">island</button>
    <button class="mx-mode" data-mx="dist">switches from the start</button>
    <button class="mx-mode" data-mx="sweep">the sweep</button>
    <span class="num muted" id="mx-note"></span>
  </div>
  <div class="controls" id="sweep-controls" style="display:none">
    <button id="sw-prev">&#9664; back</button>
    <button id="sw-next">+1 switch &#9654;</button>
    <span class="num" id="sw-readout"></span>
  </div>
  <div id="matrix-box"></div>
  <p class="muted">Below: this step's regions, union-joined, and the island
  count before &rarr; after.</p>
  <div id="step-cliques"></div>

  <h2>4 &middot; The islands the build produced</h2>
  <p>An island = pictures the robots can slide between, shown as a row of
  pictures. Solid border = start, dashed = goal.</p>
  <div class="readout" id="island-summary"></div>
  <div id="island-decide"></div>
  <p>Storage: every state holds one pointer; following pointers ends at the
  island's root (amber border). <strong>An arrow is a stored pointer, not a
  robot move</strong> — chain neighbours can be many slides apart. Hover an
  arrow for the parked position that wrote it.</p>
  <div id="chain-view"></div>
  <div class="islandhead">Remember how we came — the log unfolded into a real solution</div>
  <p>Each row = one segment, one robot sliding while the other stands still.
  <strong>remembered</strong>: the build's proof pairs replayed as filed —
  legal, not minimal. <strong>shortcut</strong>: greedy farthest jump.
  <strong>shortest</strong>: breadth-first over the cliques — the exact
  minimum.</p>
  <div class="readout" id="trail-readout">No trail: the start and the goal are on different islands.</div>
  <div class="controls" id="trail-controls">
    <button class="trail-mode" data-mode="remembered">remembered</button>
    <button class="trail-mode" data-mode="shortcut">shortcut</button>
    <button class="trail-mode" data-mode="shortest">shortest</button>
  </div>
  <div class="trailwrap">
    <div id="trail-player" style="flex: 1 1 560px; min-width: 320px"></div>
    <ol id="trail-list" class="muted"></ol>
  </div>
  <div class="readout num" id="trail-path"></div>
  <table class="stats" id="island-table">
    <thead><tr><th></th><th>Island</th><th class="num">states</th><th>holds the start</th><th>holds the goal</th></tr></thead>
    <tbody></tbody>
  </table>
  <div id="island-galleries"></div>
  <p class="muted">Same islands, sliced: B parked at its start, A's positions
  coloured by island.</p>
  <div class="boardbox" id="board-islands"></div>

  <h2>5 &middot; <code>_state</code> and <code>_exchange</code> — the start and its twin</h2>
  <p><code>_state</code>: two positions &rarr; one number.
  <code>_exchange</code>: swap its halves = swap the labels. The goal is the
  start's exchange.</p>
  <div class="twoboards">
    <figure><div id="board-start"></div><figcaption>the start</figcaption></figure>
    <figure><div id="board-goal"></div><figcaption>its exchange — the goal</figcaption></figure>
  </div>

  <h2>6 &middot; <code>solvable</code> — one comparison</h2>
  <p>Start's island vs goal's island — one comparison, no search.</p>
  <div class="readout" id="verdict-readout"></div>

  <h2>7 &middot; <code>swap_combinations</code> — where a swap can pass</h2>
  <p>A swap combination = a state on the start's island whose exchange is
  there too; its route, replayed backwards with the labels swapped, finishes
  the swap.</p>
  <div class="readout" id="combo-readout"></div>

  <h2>8 &middot; Ask it yourself — <code>solvable</code> on any start</h2>
  <p>Click a corner for A, another for B; a third click restarts. Faint dots =
  where the other robot could stand in a swap combination.</p>
  <div class="controls">
    <button id="q-start">use the test's start</button>
    <button id="q-clear">clear</button>
  </div>
  <div class="readout" id="q-readout">No start chosen yet.</div>
  <div class="trailwrap">
    <div class="boardbox" id="board-query"></div>
    <ol id="q-trail" class="muted"></ol>
  </div>
  <div class="readout num" id="q-path" hidden></div>


  <script type="application/json" id="data">{{ data_json | safe }}</script>
  <script>
  "use strict";
  const D = JSON.parse(document.getElementById("data").textContent);
  const ROWS = D.grid.rows, COLS = D.grid.cols, N = D.n;
  const RS = D.placement_rows, CS = D.placement_cols, MAXPOS = RS * CS;
  const WALLS = D.grid.walls, HOLES = D.holes;
  const CELL = 20;
  const LAB = { a: "A", b: "B" };
  const REGION_COLORS = ["#2563eb","#d97706","#059669","#db2777","#7c3aed","#0891b2","#ca8a04","#dc2626"];

  const pr = i => [Math.floor(i / CS), i % CS];
  const overlap = (a, b) => {
    const ra = Math.floor(a / CS), ca = a % CS, rb = Math.floor(b / CS), cb = b % CS;
    return Math.abs(ra - rb) < N && Math.abs(ca - cb) < N;
  };
  const exchange = s => (s % MAXPOS) * MAXPOS + Math.floor(s / MAXPOS);

  const VALID = new Set(D.valid);
  // Every legal ordered pair, exactly as _all_states yields them.
  const STATES = [];
  for (const a of D.valid) for (const b of D.valid) if (a !== b && !overlap(a, b)) STATES.push(a * MAXPOS + b);

  // Union-find, mirroring _find / _union including path compression.
  function makeUF() { const p = new Int32Array(MAXPOS * MAXPOS); for (let i = 0; i < p.length; i++) p[i] = i; return p; }
  function find(p, x) {
    let root = x;
    while (p[root] !== root) root = p[root];
    while (p[x] !== root) { const nxt = p[x]; p[x] = root; x = nxt; }
    return root;
  }
  function union(p, x, y) { const rx = find(p, x), ry = find(p, y); if (rx !== ry) p[ry] = rx; }
  function applyStep(p, st) {
    for (const region of st.regions) {
      const head = region[0];
      for (let j = 1; j < region.length; j++) {
        union(p, head * MAXPOS + st.parked, region[j] * MAXPOS + st.parked);
        union(p, st.parked * MAXPOS + head, st.parked * MAXPOS + region[j]);
      }
    }
  }
  function islandCount(p) { const roots = new Set(); for (const s of STATES) roots.add(find(p, s)); return roots.size; }

  // The finished map — the end state the slider reaches.
  const FULL = makeUF();
  for (const st of D.steps) applyStep(FULL, st);

  // The islands of the finished map: size per representative, numbered by
  // size, one colour each. S0 is the start state, G0 its exchange — the goal.
  const S0 = D.start.a * MAXPOS + D.start.b, G0 = exchange(S0);
  const sizeByRoot = new Map();
  for (const s of STATES) { const r = find(FULL, s); sizeByRoot.set(r, (sizeByRoot.get(r) || 0) + 1); }
  const ISLANDS = [...sizeByRoot.entries()].sort((x, y) => y[1] - x[1]);
  const islandNo = new Map(); ISLANDS.forEach((e, i) => islandNo.set(e[0], i + 1));
  const islandColor = root => REGION_COLORS[(islandNo.get(root) - 1) % REGION_COLORS.length];

  // The board renderer and clique machinery are shared — see _board.js — and
  // the zoomable viewport, board() and makePlayer come verbatim from the
  // report pages' _player.js, so robots, arrows, labels and controls match.
{% include "_board.js" %}
{% include "_player.js" %}



  // ── 1: the board as read ─────────────────────────────────────────────
  const bRead = makeBoard("board-read");
  drawRobot(bRead, D.start.a, "var(--a)", "A");
  drawRobot(bRead, D.start.b, "var(--b)", "B");

  // ── 2: erode_window ──────────────────────────────────────────────────
  const bFit = makeBoard("board-fit");
  dots(bFit);

  // ── 3: the build, stepped ────────────────────────────────────────────
  const bBuild = makeBoard("board-build");
  const range = document.getElementById("step-range");
  range.max = D.steps.length;
  const readout = document.getElementById("step-readout");

  // The state matrix: the whole parent array as pixels, one square per state,
  // coloured by its current leader, redrawn at every slider position.
  const MPAL = ["#2563eb","#d97706","#059669","#db2777","#7c3aed","#0891b2","#ca8a04","#dc2626",
                "#4f46e5","#0d9488","#be185d","#65a30d","#9333ea","#b91c1c","#0369a1","#a16207"];
  // Axes span the FULL corner rectangle, obstacle corners included, so the
  // matrix carries its own explanation: wall-coloured squares are corners a
  // robot cannot stand on at all. Cell size adapts so the canvas stays in a
  // workable resolution band; the shared viewport does the on-screen sizing.
  const NP = MAXPOS;
  // Cell size: as large as a ~4000px canvas allows, so the switch-count
  // digits fit inside the cells on all but the biggest boards (there, cells
  // fall below 8px, digits are skipped, and hover still carries the number).
  const MPX = Math.max(4, Math.min(28, Math.floor(4000 / NP)));
  document.getElementById("matrix-box").innerHTML = frame("", { key: "matrix", h: 560 });
  const mcv = document.createElement("canvas");
  mcv.id = "state-matrix";
  mcv.width = NP * MPX;
  mcv.height = NP * MPX;
  document.querySelector("#matrix-box .boardzoom").appendChild(mcv);
  let MP = null;
  let MXMODE = "island";
  // Distance rings: breadth-first over EVERY clique from the start's two,
  // with no goal to stop at. A state's distance is the shallowest ring of the
  // (at most two) cliques holding it, minus one — exactly min_switches to it.
  const RING = new Map();
  {
    const ckey = c => c[0] + ":" + c[1] + ":" + c[2];
    const q = [];
    for (const cid of [[0, D.start.b, pieceIdx(D.start.b, D.start.a)],
                       [1, D.start.a, pieceIdx(D.start.a, D.start.b)]]) {
      const k = ckey(cid);
      if (!RING.has(k)) { RING.set(k, 1); q.push(cid); }
    }
    let qi = 0;
    while (qi < q.length) {
      const cid = q[qi++];
      const r = RING.get(ckey(cid));
      for (const member of PIECES.get(cid[1])[cid[2]]) {
        const ncid = [1 - cid[0], member, pieceIdx(member, cid[1])];
        const nk = ckey(ncid);
        if (!RING.has(nk)) { RING.set(nk, r + 1); q.push(ncid); }
      }
    }
  }
  const distOf = (a, b) => {
    const r0 = RING.get("0:" + b + ":" + pieceIdx(b, a));
    const r1 = RING.get("1:" + a + ":" + pieceIdx(a, b));
    const best = Math.min(r0 === undefined ? Infinity : r0, r1 === undefined ? Infinity : r1);
    return best === Infinity ? null : best - 1;
  };
  let MAXD = 0;
  for (const s of STATES) {
    const d = distOf(Math.floor(s / MAXPOS), s % MAXPOS);
    if (d !== null && d > MAXD) MAXD = d;
  }
  // Hue runs blue -> red with distance, and lightness ALTERNATES per ring, so
  // ring k and ring k+1 always contrast instead of smearing into a gradient.
  const distColor = d => d === null
    ? "#2b2f35"
    : "hsl(" + Math.round(220 - 220 * (MAXD ? d / MAXD : 0)) + ",75%," + (d % 2 ? 63 : 45) + "%)";
  // Sweep mode: the same ring walk replayed one switch at a time. SWEEPW[r]
  // lists the cliques the walk reaches at ring r (r = switches + 1), read
  // back out of RING, whose keys encode (who-is-parked, where, which piece).
  let SWSTEP = 0;
  const SWEEPW = [];
  for (const [k, r] of RING) {
    const [o, parked, pi] = k.split(":").map(Number);
    (SWEEPW[r] = SWEEPW[r] || []).push({ o, parked, pi });
  }
  const SWEEP_NOTE = "coloured square = lit (reached), white frame = newly lit by " +
    "this run, tinted full-length band = the straight run just swept (a column: A " +
    "slides while B is parked — a row: B slides while A is parked), black dot = the " +
    "square where control switched into that run, dim grey = not lit yet";
  function swText() {
    let lit = 0, total = 0;
    for (const s of STATES) {
      const d = distOf(Math.floor(s / MAXPOS), s % MAXPOS);
      if (d !== null) { total += 1; if (d <= SWSTEP) lit += 1; }
    }
    const goalD = distOf(D.start.b, D.start.a);
    return "after " + SWSTEP + " switch(es): " + lit.toLocaleString() + " of " +
      total.toLocaleString() + " reachable situations lit — " +
      (goalD === null ? "the goal never lights up"
        : goalD <= SWSTEP ? "GOAL is lit (it took " + goalD + ")"
        : "GOAL not lit yet (it takes " + goalD + ")");
  }
  function drawMatrix(p) {
    MP = p;
    const ctx = mcv.getContext("2d");
    // Dark backing shows through the 1px gap each cell leaves — a hairline
    // grid, so squares read as squares instead of merging into fields.
    ctx.fillStyle = "#394049";
    ctx.fillRect(0, 0, mcv.width, mcv.height);
    // Island colours are labels, not values: assigned in discovery order per
    // redraw, so the first group found is always the first palette colour and
    // a finished one-island board is always the same blue, case after case.
    const order = new Map();
    for (let a = 0; a < NP; a++) for (let b = 0; b < NP; b++) {
      const aOk = VALID.has(a), bOk = VALID.has(b);
      let fill;
      if (!aOk || !bOk) {
        // A robot would stand on a wall there. Obstacle wins over overlap.
        fill = D.palette.wall;
      } else if (a === b || overlap(a, b)) {
        fill = "#e5e7eb";
      } else if (MXMODE === "dist") {
        fill = distColor(distOf(a, b));
      } else if (MXMODE === "sweep") {
        const d = distOf(a, b);
        fill = d === null ? "#2b2f35" : d <= SWSTEP ? distColor(d) : "#505864";
      } else {
        const root = find(p, a * MAXPOS + b);
        let ci = order.get(root);
        if (ci === undefined) { ci = order.size; order.set(root, ci); }
        fill = MPAL[ci % MPAL.length];
      }
      ctx.fillStyle = fill;
      ctx.fillRect(b * MPX, a * MPX, MPX - 1, MPX - 1);
      // Overlap squares get an × on the light grey, so they cannot be read as
      // any plain fill — the sweep's dim not-yet-lit grey especially.
      if (aOk && bOk && (a === b || overlap(a, b))) {
        ctx.strokeStyle = "#6b7280";
        ctx.lineWidth = Math.max(1.5, (MPX - 1) / 6);
        ctx.beginPath();
        ctx.moveTo(b * MPX + 1, a * MPX + 1);
        ctx.lineTo(b * MPX + MPX - 2, a * MPX + MPX - 2);
        ctx.moveTo(b * MPX + 1, a * MPX + MPX - 2);
        ctx.lineTo(b * MPX + MPX - 2, a * MPX + 1);
        ctx.stroke();
      }
      // The switch count printed in the square, black on the light rings and
      // white on the dark ones, so the number and the colour say it together.
      if (MXMODE !== "island" && aOk && bOk && a !== b && !overlap(a, b) && MPX >= 8) {
        const d = distOf(a, b);
        if (d !== null && (MXMODE === "dist" || d <= SWSTEP)) {
          ctx.fillStyle = d % 2 ? "#000" : "#fff";
          ctx.font = "700 " + Math.max(5, Math.floor(MPX * 0.55)) + "px ui-sans-serif, sans-serif";
          ctx.textAlign = "center";
          ctx.textBaseline = "middle";
          ctx.fillText(String(d), b * MPX + (MPX - 1) / 2, a * MPX + MPX / 2);
        }
      }
      // Unreachable gets a light slash on near-black, so it cannot be read
      // as background or grid.
      if (MXMODE !== "island" && aOk && bOk && a !== b && !overlap(a, b) && distOf(a, b) === null) {
        ctx.strokeStyle = "#b9c0c9";
        ctx.lineWidth = Math.max(1.5, (MPX - 1) / 6);
        ctx.beginPath();
        ctx.moveTo(b * MPX + 1, a * MPX + MPX - 2);
        ctx.lineTo(b * MPX + MPX - 2, a * MPX + 1);
        ctx.stroke();
      }
    }
    // Sweep overlays: each run of the current wave as a tinted full-length
    // band (a clique lives entirely in one row or one column), a white frame
    // on every square that run lights for the first time, and a black dot on
    // the square where control switched into the run — the perpendicular
    // turn, made visible.
    if (MXMODE === "sweep") {
      const wave = SWEEPW[SWSTEP + 1] || [];
      ctx.globalAlpha = 0.22;
      ctx.fillStyle = distColor(SWSTEP);
      for (const c of wave) {
        if (c.o === 0) ctx.fillRect(c.parked * MPX, 0, MPX - 1, mcv.height);
        else ctx.fillRect(0, c.parked * MPX, mcv.width, MPX - 1);
      }
      ctx.globalAlpha = 1;
      for (const c of wave) {
        for (const m of PIECES.get(c.parked)[c.pi]) {
          const a = c.o === 0 ? m : c.parked, b = c.o === 0 ? c.parked : m;
          const d = distOf(a, b);
          if (d === SWSTEP) {
            ctx.strokeStyle = "#fff";
            ctx.lineWidth = Math.max(1.5, MPX / 7);
            ctx.strokeRect(b * MPX + 1.5, a * MPX + 1.5, MPX - 4, MPX - 4);
          } else if (d === SWSTEP - 1) {
            ctx.fillStyle = "#000";
            ctx.beginPath();
            ctx.arc(b * MPX + (MPX - 1) / 2, a * MPX + MPX / 2, Math.max(2, MPX / 5), 0, Math.PI * 2);
            ctx.fill();
          }
        }
      }
    }
    // Start and goal markers: the state's square framed and labelled in
    // magenta, because no ring colour and no cell class uses it — the
    // obstacle squares are wall-black, so the markers must not be.
    const MARKC = "#ff2d95";
    const marker = (s, inner, label) => {
      const i = Math.floor(s / MAXPOS), j = s % MAXPOS;
      ctx.fillStyle = MARKC;
      ctx.fillRect(j * MPX - 2, i * MPX - 2, MPX + 3, MPX + 3);
      ctx.fillStyle = inner;
      ctx.fillRect(j * MPX, i * MPX, MPX - 1, MPX - 1);
      // The word itself, haloed, flipped inward so it never clips off an edge.
      ctx.font = "700 13px ui-sans-serif, system-ui, sans-serif";
      ctx.textBaseline = "middle";
      const leftward = j * MPX > mcv.width / 2;
      ctx.textAlign = leftward ? "right" : "left";
      const x = leftward ? j * MPX - 6 : j * MPX + MPX + 5;
      const y = Math.min(Math.max(i * MPX + MPX / 2, 9), mcv.height - 9);
      ctx.lineWidth = 4;
      ctx.strokeStyle = "#fff";
      ctx.strokeText(label, x, y);
      ctx.fillStyle = "#000";
      ctx.fillText(label, x, y);
    };
    marker(D.start.a * MAXPOS + D.start.b, MARKC, "START");
    marker(D.start.b * MAXPOS + D.start.a, "#fff", "GOAL");
  }
  mcv.addEventListener("mousemove", ev => {
    if (!MP) return;
    const box = mcv.getBoundingClientRect();
    const b = Math.floor((ev.clientX - box.left) / box.width * NP);
    const a = Math.floor((ev.clientY - box.top) / box.height * NP);
    if (a < 0 || b < 0 || a >= NP || b >= NP) return;
    const pa = pr(a), pb = pr(b);
    if (!VALID.has(a) || !VALID.has(b)) {
      const who = !VALID.has(a) && !VALID.has(b) ? "both robots" : !VALID.has(a) ? "robot A" : "robot B";
      mcv.title = "A (" + pa + "), B (" + pb + ") — " + who + " would stand on a wall: not a situation";
      return;
    }
    if (a === b || overlap(a, b)) {
      mcv.title = "A (" + pa + "), B (" + pb + ") — the robots would overlap: not a situation";
      return;
    }
    const s = a * MAXPOS + b;
    const d = distOf(a, b);
    mcv.title = "slot " + s + ": A (" + pa + "), B (" + pb + ") — holds " + MP[s] +
      ", leader " + find(MP, s) +
      (d === null ? " — unreachable from the start" : " — " + d + " switch(es) from the start");
  });
  const ISLAND_NOTE = "colours are group labels in discovery order, not values — one colour left = one island";
  // The scale, spelled out: one numbered chip per ring, so a shade is read by
  // matching it here rather than by guessing what a hue means.
  const distLegend = () => {
    const step = Math.max(1, Math.ceil((MAXD + 1) / 16));
    let html = "switches from the start:&nbsp; ";
    for (let d = 0; d <= MAXD; d += step) {
      html += '<span class="chip" style="background:' + distColor(d) + '"></span>' + d + "&nbsp; ";
    }
    const goalD = distOf(D.start.b, D.start.a);
    html += '&middot; <span class="chip" style="background:#2b2f35"></span>unreachable (near-black, slashed)' +
      " &middot; the goal sits at " + (goalD === null ? "—" : goalD) + " switch(es)";
    return html;
  };
  document.querySelectorAll(".mx-mode").forEach(btn => btn.addEventListener("click", () => {
    MXMODE = btn.dataset.mx;
    document.querySelectorAll(".mx-mode").forEach(other => {
      other.style.borderColor = other === btn ? "var(--ink)" : "var(--line)";
    });
    if (MXMODE === "dist") document.getElementById("mx-note").innerHTML = distLegend();
    else if (MXMODE === "sweep") document.getElementById("mx-note").textContent = SWEEP_NOTE;
    else document.getElementById("mx-note").textContent = ISLAND_NOTE;
    document.getElementById("sweep-controls").style.display = MXMODE === "sweep" ? "" : "none";
    if (MXMODE === "sweep") document.getElementById("sw-readout").textContent = swText();
    if (MP) drawMatrix(MP);
  }));
  document.querySelector('.mx-mode[data-mx="island"]').style.borderColor = "var(--ink)";
  document.getElementById("mx-note").textContent = ISLAND_NOTE;
  const swStep = delta => {
    const next = SWSTEP + delta;
    if (next < 0 || next > MAXD) return;
    SWSTEP = next;
    document.getElementById("sw-readout").textContent = swText();
    if (MP) drawMatrix(MP);
  };
  document.getElementById("sw-prev").addEventListener("click", () => swStep(-1));
  document.getElementById("sw-next").addEventListener("click", () => swStep(1));

  function renderStep(k) {
    const p = makeUF();
    let unions = 0;
    for (let i = 0; i < k - 1; i++) {
      applyStep(p, D.steps[i]);
      for (const reg of D.steps[i].regions) unions += 2 * Math.max(0, reg.length - 1);
    }
    // Island count just before this step's unions, so the step's own effect
    // can be reported as before -> after.
    const islandsBefore = islandCount(p);
    if (k > 0) {
      applyStep(p, D.steps[k - 1]);
      for (const reg of D.steps[k - 1].regions) unions += 2 * Math.max(0, reg.length - 1);
    }
    clearOverlay(bBuild);
    dots(bBuild);
    let line = "";
    if (k > 0) {
      const st = D.steps[k - 1];
      const [sr, sc] = pr(st.parked);
      // Valid placements excluded for overlapping the parked robot — the
      // (2n-1)-sided square _build subtracts, shown crossed out.
      for (const v of D.valid) {
        if (v !== st.parked && overlap(v, st.parked)) markCorner(bBuild, v, "#fca5a5", 4);
      }
      st.regions.forEach((reg, ri) => { for (const m of reg) markCorner(bBuild, m, REGION_COLORS[ri % REGION_COLORS.length], 4); });
      drawRobot(bBuild, st.parked, "#374151", "P");
      const usable = st.regions.reduce((acc, reg) => acc + reg.length, 0);
      line = "Parked at (" + sr + ", " + sc + "): " + usable + " usable placements in " +
        st.regions.length + " region(s). ";
    }
    const islands = islandCount(p);
    drawMatrix(p);
    const startState = D.start.a * MAXPOS + D.start.b;
    const joined = find(p, startState) === find(p, exchange(startState));
    line += "After " + k + " of " + D.steps.length + " parked positions: " +
      unions.toLocaleString() + " unions, " + islands.toLocaleString() + " islands among " +
      STATES.length.toLocaleString() + " states. Start and goal on one island: " + (joined ? "YES" : "not yet");
    if (k === 0) line += ". Before any joining, every state counts as its own island — watch the number fall";
    if (k === Number(range.max)) {
      const agree = STATES.length === D.map.states && joined === D.map.solvable;
      line += agree
        ? " — matches what Python recorded."
        : " — DOES NOT MATCH what Python recorded (" + D.map.states + " states, solvable=" + D.map.solvable + ").";
      readout.className = agree ? "readout ok" : "readout bad";
    } else {
      readout.className = "readout";
    }
    readout.textContent = line;

    // The joining, as pictures: this step's cliques and what they fused.
    const panel = document.getElementById("step-cliques");
    panel.innerHTML = "";
    if (k > 0) {
      const st = D.steps[k - 1];
      const REG_CAP = 3, TH = COLS > 24 ? 6 : 10;
      st.regions.slice(0, REG_CAP).forEach((reg, ri) => {
        const color = REGION_COLORS[ri % REGION_COLORS.length];
        const head = document.createElement("div");
        head.className = "islandhead";
        head.innerHTML = '<span class="chip" style="background:' + color + '"></span>Region of ' +
          reg.length + " placement(s) — every picture below is union-joined into ONE group";
        panel.appendChild(head);
        const mkRow = (roamerIsA, label) => {
          const wrap = document.createElement("div");
          wrap.className = "thumbgrid";
          const lab = document.createElement("span");
          lab.className = "muted";
          lab.style.minWidth = "180px";
          lab.textContent = label;
          wrap.appendChild(lab);
          for (const m of reg.slice(0, TH)) {
            wrap.appendChild(thumb(roamerIsA ? m * MAXPOS + st.parked : st.parked * MAXPOS + m));
          }
          if (reg.length > TH) {
            const more = document.createElement("span");
            more.className = "muted";
            more.textContent = "+ " + (reg.length - TH) + " more";
            wrap.appendChild(more);
          }
          panel.appendChild(wrap);
        };
        mkRow(true, "parked robot plays B, A roams:");
        mkRow(false, "parked robot plays A, B roams:");
      });
      if (st.regions.length > REG_CAP) {
        const more = document.createElement("div");
        more.className = "muted";
        more.textContent = "+ " + (st.regions.length - REG_CAP) +
          " more region(s) this step, joined the same way.";
        panel.appendChild(more);
      }
      const fused = document.createElement("div");
      fused.className = "readout";
      fused.textContent = "Islands before this step: " + islandsBefore.toLocaleString() +
        " → after: " + islands.toLocaleString() +
        (islandsBefore > islands
          ? ". This step fused " + (islandsBefore - islands).toLocaleString() +
            " group(s) together, because its cliques share pictures with earlier ones."
          : ". No previously separate groups were fused by this step.");
      panel.appendChild(fused);
    } else {
      panel.innerHTML = '<span class="muted">Advance the slider — each step shows here exactly which pictures get joined.</span>';
    }
  }
  range.addEventListener("input", () => renderStep(Number(range.value)));
  document.getElementById("step-prev").addEventListener("click", () => { range.value = Math.max(0, Number(range.value) - 1); renderStep(Number(range.value)); });
  document.getElementById("step-next").addEventListener("click", () => { range.value = Math.min(Number(range.max), Number(range.value) + 1); renderStep(Number(range.value)); });
  document.getElementById("step-end").addEventListener("click", () => { range.value = range.max; renderStep(Number(range.value)); });
  renderStep(0);

  // ── 4: the islands — summary line, table, and the parked-B slice ─────
  {
    document.getElementById("stat-islands").textContent = ISLANDS.length.toLocaleString() + " island(s)";
    document.getElementById("island-summary").textContent =
      ISLANDS.length.toLocaleString() + " island(s) over " + STATES.length.toLocaleString() +
      " states" + (ISLANDS.length === 1 ? " — every picture can reach every other." : ".");
    const tbody = document.querySelector("#island-table tbody");
    const rootS = find(FULL, S0), rootG = find(FULL, G0);
    const LIMIT = 12;
    for (const entry of ISLANDS.slice(0, LIMIT)) {
      const root = entry[0], size = entry[1];
      const tr = document.createElement("tr");
      tr.innerHTML = '<td><span class="chip" style="background:' + islandColor(root) + '"></span></td>' +
        "<td>Island " + islandNo.get(root) + "</td>" +
        '<td class="num">' + size.toLocaleString() + "</td>" +
        "<td>" + (root === rootS ? "start &check;" : "&mdash;") + "</td>" +
        "<td>" + (root === rootG ? "goal &check;" : "&mdash;") + "</td>";
      tbody.appendChild(tr);
    }
    if (ISLANDS.length > LIMIT) {
      const tr = document.createElement("tr");
      tr.innerHTML = '<td></td><td colspan="4" class="muted">+ ' + (ISLANDS.length - LIMIT) + " smaller islands</td>";
      tbody.appendChild(tr);
    }
    const bIsl = makeBoard("board-islands");
    for (const v of D.valid) {
      if (v === D.start.b || overlap(v, D.start.b)) continue;
      markCorner(bIsl, v, islandColor(find(FULL, v * MAXPOS + D.start.b)), 4);
    }
    drawRobot(bIsl, D.start.b, "var(--b)", "B");

    // How the decision is made, as pictures: the start and the goal, each
    // badged with its island. Matching badges IS the verdict.
    const decide = document.getElementById("island-decide");
    const mkFig = (s, label, root, mark) => {
      const fig = document.createElement("figure");
      fig.appendChild(thumb(s, mark));
      const cap = document.createElement("figcaption");
      cap.className = "thumb-label";
      cap.innerHTML = label + ' &mdash; <span class="badge" style="background:' +
        islandColor(root) + '">Island ' + islandNo.get(root) + "</span>";
      fig.appendChild(cap);
      return fig;
    };
    const row = document.createElement("div");
    row.className = "thumbrow";
    row.appendChild(mkFig(S0, "START: A and B as given", rootS, "startmark"));
    row.appendChild(mkFig(G0, "GOAL: A and B exchanged", rootG, "goalmark"));
    decide.appendChild(row);
    const dv = document.createElement("div");
    dv.className = "readout " + (rootS === rootG ? "ok" : "bad");
    dv.textContent = rootS === rootG
      ? "Both badges name the same island, so some chain of slides carries the start picture to the goal picture: the swap is possible."
      : "The badges name different islands: no chain of slides connects the start to the goal, so the swap is impossible.";
    decide.appendChild(dv);

    // The pointer chains, drawn. A second parent array is built WITHOUT path
    // compression, purely for display: the compressed one answers in one hop,
    // which is efficient but shows nothing of the tree it flattened.
    const RAW = new Int32Array(MAXPOS * MAXPOS);
    for (let i = 0; i < RAW.length; i++) RAW[i] = i;
    const rawRoot = x => { while (RAW[x] !== x) x = RAW[x]; return x; };
    // Which parked position wrote each pointer, so the drawing can say why a
    // hop exists rather than leaving it to look like a move.
    const CAUSE = new Map();
    // PROOF: for every write, also remember the two STATES whose joining
    // caused it — both lie in one clique, so each proof pair is one legal
    // segment. The write-causing pairs form a spanning trail of the island.
    const PROOF = new Map();
    const proofEdge = (x, y, parked) => {
      if (!PROOF.has(x)) PROOF.set(x, []);
      if (!PROOF.has(y)) PROOF.set(y, []);
      PROOF.get(x).push({ to: y, parked });
      PROOF.get(y).push({ to: x, parked });
    };
    for (const st of D.steps) for (const region of st.regions) {
      const head = region[0];
      for (let j = 1; j < region.length; j++) {
        const x1 = head * MAXPOS + st.parked, y1 = region[j] * MAXPOS + st.parked;
        let a = rawRoot(x1), b = rawRoot(y1);
        if (a !== b) { RAW[b] = a; CAUSE.set(b, st.parked); proofEdge(x1, y1, st.parked); }
        const x2 = st.parked * MAXPOS + head, y2 = st.parked * MAXPOS + region[j];
        a = rawRoot(x2); b = rawRoot(y2);
        if (a !== b) { RAW[b] = a; CAUSE.set(b, st.parked); proofEdge(x2, y2, st.parked); }
      }
    }
    const rawChain = s => { const out = [s]; while (RAW[s] !== s) { s = RAW[s]; out.push(s); } return out; };
    const chainView = document.getElementById("chain-view");
    const chainRow = (label, chain, mark) => {
      const rowEl = document.createElement("div");
      rowEl.className = "chainrow";
      const lab = document.createElement("span");
      lab.className = "chainlabel";
      lab.textContent = label;
      rowEl.appendChild(lab);
      const MAXSHOW = 5;
      const shown = chain.length <= MAXSHOW
        ? chain
        : chain.slice(0, MAXSHOW - 1).concat([chain[chain.length - 1]]);
      const skipped = chain.length - shown.length;
      shown.forEach((s, i) => {
        if (i) {
          const contiguous = !(skipped > 0 && i === shown.length - 1);
          const a = document.createElement("span");
          a.className = "arrow";
          a.textContent = contiguous ? "→" : "…→";
          if (contiguous) {
            const wrote = CAUSE.get(shown[i - 1]);
            if (wrote !== undefined) {
              a.title = "pointer written while the build parked a robot at (" + pr(wrote) + ")";
            }
          } else {
            a.title = skipped + " pointer hop(s) skipped for space";
          }
          rowEl.appendChild(a);
        }
        const isLast = i === shown.length - 1;
        const fig = document.createElement("figure");
        fig.appendChild(thumb(s, isLast ? "rootmark" : (i === 0 ? mark : null)));
        const cap = document.createElement("div");
        cap.className = "slotno";
        cap.textContent = "slot " + s + (isLast ? " — the ROOT" : "");
        fig.appendChild(cap);
        rowEl.appendChild(fig);
      });
      return rowEl;
    };
    chainView.appendChild(chainRow("START", rawChain(S0), "startmark"));
    chainView.appendChild(chainRow("GOAL", rawChain(G0), "goalmark"));
    const chainNote = document.createElement("div");
    chainNote.className = "readout " + (rootS === rootG ? "ok" : "bad");
    chainNote.textContent = rootS === rootG
      ? "Both chains arrive at the same root picture: one tree, one island, swap possible."
      : "The chains arrive at two different root pictures: two separate trees, swap impossible.";
    chainView.appendChild(chainNote);

    // Three journeys from the same stored data, via the shared helpers above;
    // the exact walk is timed so the page can report its own cost.
    let modes = null, shortestMs = null;
    if (rootS === rootG) {
      const parentOf = new Map([[S0, null]]);
      const stack = [S0];
      while (stack.length) {
        const v = stack.pop();
        if (v === G0) break;
        for (const e of PROOF.get(v) || []) {
          if (!parentOf.has(e.to)) { parentOf.set(e.to, v); stack.push(e.to); }
        }
      }
      const pairs = [];
      let curv = G0;
      while (parentOf.get(curv) !== null) { pairs.push([parentOf.get(curv), curv]); curv = parentOf.get(curv); }
      pairs.reverse();
      const remembered = segsFromPairs(pairs);
      const tp0 = performance.now();
      const shortest = shortestSegs(S0, G0);
      shortestMs = performance.now() - tp0;
      modes = { remembered, shortcut: shortcutSegs(S0, remembered), shortest };
    }
    const tReadout = document.getElementById("trail-readout");
    const tControls = document.getElementById("trail-controls");
    const tList = document.getElementById("trail-list");
    if (!modes) {
      tControls.hidden = true;
      document.getElementById("trail-player").hidden = true;
      tReadout.className = "readout bad";
    } else {
      const sw = s => (s && s.length ? s.length - 1 : 0);
      const exact = modes.shortest && sw(modes.shortest) === D.solver.switches;
      tReadout.className = "readout " + (exact ? "ok" : "bad");
      tReadout.textContent = "Remembered: " + modes.remembered.length + " segments, " +
        sw(modes.remembered) + " switches · shortcut: " + modes.shortcut.length + " segments, " +
        sw(modes.shortcut) + " switches · shortest: " +
        (modes.shortest ? modes.shortest.length + " segments, " + sw(modes.shortest) + " switches" : "—") +
        ". The solver's minimum is " + D.solver.switches +
        (exact ? " — the clique walk matches it exactly." : " — MISMATCH, the clique walk disagrees.") +
        (shortestMs === null ? "" : " Shortest computed here in " + shortestMs.toFixed(1) + "ms.");
      const statMs = document.getElementById("stat-path-ms");
      if (statMs && shortestMs !== null) statMs.textContent = shortestMs.toFixed(1) + "ms in this browser";
      // The journey plays in the SAME player the report pages use: the
      // zoomable viewport, prev/Play/next, the scrubber, the per-switch
      // caption with its move string — identical robots, arrows and labels.
      const GRID = { walls: WALLS, rows: ROWS, cols: COLS };
      const modeButtons = document.querySelectorAll(".trail-mode");
      let mode = "remembered";
      const renderList = () => {
        tList.innerHTML = "";
        for (const g of modes[mode]) {
          const li = document.createElement("li");
          li.textContent = g.mover + " slides from (" + pr(g.from) + ") to (" + pr(g.to) +
            ") while " + (g.mover === "A" ? "B" : "A") + " stands at (" + pr(g.parked) +
            ")  —  " + (segCmds(g) || "·");
          tList.appendChild(li);
        }
        // The same journey in the project's command units, S between segments.
        document.getElementById("trail-path").textContent = pathString(modes[mode]);
        modeButtons.forEach(b => { b.style.borderColor = b.dataset.mode === mode ? "var(--ink)" : "var(--line)"; });
      };
      const mount = () => makePlayer(document.getElementById("trail-player"), GRID,
        playerSteps(S0, modes[mode]), N, 40, "trail");
      modeButtons.forEach(btn => btn.addEventListener("click", () => {
        mode = btn.dataset.mode;
        renderList();
        mount();
      }));
      renderList();
      mount();
    }

    // Every island as a row of its pictures — the start and goal first where
    // they belong, then a sample, with the remainder counted honestly.
    const SAMPLE = 36, GALLERY_ISLANDS = 8;
    const members = new Map();
    for (const s of STATES) {
      const r = find(FULL, s);
      let m = members.get(r);
      if (!m) { m = []; members.set(r, m); }
      if (m.length < SAMPLE && s !== S0 && s !== G0) m.push(s);
    }
    const gal = document.getElementById("island-galleries");
    for (const entry of ISLANDS.slice(0, GALLERY_ISLANDS)) {
      const root = entry[0], size = entry[1];
      const head = document.createElement("div");
      head.className = "islandhead";
      head.innerHTML = '<span class="chip" style="background:' + islandColor(root) + '"></span>Island ' +
        islandNo.get(root) + " &mdash; " + size.toLocaleString() + " state(s)";
      gal.appendChild(head);
      const grid = document.createElement("div");
      grid.className = "thumbgrid";
      let shown = 0;
      if (root === rootS) { grid.appendChild(thumb(S0, "startmark")); shown++; }
      if (root === rootG && G0 !== S0) { grid.appendChild(thumb(G0, "goalmark")); shown++; }
      for (const s of members.get(root) || []) { grid.appendChild(thumb(s)); shown++; }
      if (size > shown) {
        const more = document.createElement("div");
        more.className = "muted";
        more.textContent = "+ " + (size - shown).toLocaleString() + " more states on this island";
        grid.appendChild(more);
      }
      gal.appendChild(grid);
    }
    if (ISLANDS.length > GALLERY_ISLANDS) {
      const more = document.createElement("div");
      more.className = "muted";
      more.textContent = "+ " + (ISLANDS.length - GALLERY_ISLANDS) + " smaller islands not shown as galleries.";
      gal.appendChild(more);
    }
  }

  // ── 5: the start and its exchange ────────────────────────────────────
  const bStart = makeBoard("board-start", 440);
  drawRobot(bStart, D.start.a, "var(--a)", "A");
  drawRobot(bStart, D.start.b, "var(--b)", "B");
  const bGoal = makeBoard("board-goal", 440);
  drawRobot(bGoal, D.start.b, "var(--a)", "A");
  drawRobot(bGoal, D.start.a, "var(--b)", "B");

  // ── 6: the verdict, as the comparison it actually is ─────────────────
  const canSwap = find(FULL, S0) === find(FULL, G0);
  const vOut = document.getElementById("verdict-readout");
  {
    const iS = islandNo.get(find(FULL, S0)), iG = islandNo.get(find(FULL, G0));
    const agree = canSwap === D.map.solvable && canSwap === D.solver.solvable;
    vOut.className = "readout " + (agree ? "ok" : "bad");
    vOut.textContent = "_state(start) = " + S0.toLocaleString() + ", on Island " + iS +
      ".  _state(goal) = _exchange(start) = " + G0.toLocaleString() + ", on Island " + iG + ".  " +
      (canSwap ? "Same island, so the swap IS possible." : "Different islands, so the swap is NOT possible.") +
      (agree ? " Python's map and the solver both agree." :
        " MISMATCH: Python's map says " + D.map.solvable + ", the solver says " + D.solver.solvable + ".");
  }

  // ── 7: swap combinations ─────────────────────────────────────────────
  {
    let combos = 0;
    if (canSwap) {
      const root = find(FULL, S0);
      for (const t of STATES) if (t !== S0 && find(FULL, t) === root) combos++;
    }
    const cOut = document.getElementById("combo-readout");
    const agree = combos === D.map.swap_combinations;
    cOut.className = "readout " + (agree ? "ok" : "bad");
    cOut.textContent = "Counted here in the browser: " + combos.toLocaleString() +
      " swap combinations for this start. Python recorded " +
      D.map.swap_combinations.toLocaleString() + (agree ? " — they match." : " — MISMATCH.");
  }

  // ── 8: ask it yourself — any start, same comparison ──────────────────
  const bQuery = makeBoard("board-query", 560, true);
  const qReadout = document.getElementById("q-readout");
  let qA = null, qB = null;
  function renderQuery() {
    clearOverlay(bQuery);
    dots(bQuery);
    const qTrail = document.getElementById("q-trail");
    const qPath = document.getElementById("q-path");
    qTrail.innerHTML = "";
    qPath.hidden = true;
    if (qA !== null && qB !== null) {
      const s = qA * MAXPOS + qB;
      const can = find(FULL, s) === find(FULL, exchange(s));
      const root = find(FULL, s);
      let combos = 0;
      for (const t of STATES) {
        if (t === s || find(FULL, t) !== root) continue;
        combos++;
        if (Math.floor(t / MAXPOS) === qA) markCorner(bQuery, t % MAXPOS, "var(--b)", 3);
      }
      const rootX = find(FULL, exchange(s));
      qReadout.className = "readout " + (can ? "ok" : "bad");
      qReadout.innerHTML = "Your start: A at (" + pr(qA) + "), B at (" + pr(qB) + ") &mdash; " +
        '<span class="chip" style="background:' + islandColor(root) + '"></span>Island ' +
        islandNo.get(root) + " of " + ISLANDS.length + ". Its exchanged picture: " +
        '<span class="chip" style="background:' + islandColor(rootX) + '"></span>Island ' +
        islandNo.get(rootX) + ". " +
        (can
          ? "Same island, so the swap IS possible. Swap combinations for this start: " + combos.toLocaleString() + "."
          : "A different island, so the swap is NOT possible.");
      if (can) {
        const tq0 = performance.now();
        const best = shortestSegs(s, exchange(s));
        const ms = performance.now() - tq0;
        qReadout.innerHTML += " Shortest swap from here: <b>" + Math.max(0, best.length - 1) +
          " switch(es)</b>, found in " + ms.toFixed(1) + "ms.";
        for (const g of best) {
          const li = document.createElement("li");
          li.textContent = g.mover + ": (" + pr(g.from) + ") → (" + pr(g.to) +
            ")  —  " + (segCmds(g) || "·");
          qTrail.appendChild(li);
        }
        qPath.hidden = false;
        qPath.textContent = pathString(best);
      }
    } else {
      qReadout.className = "readout";
      qReadout.textContent = qA === null
        ? "Click a dotted corner to place robot A."
        : "Now click a corner for robot B — it may touch A, not overlap it.";
    }
    if (qA !== null) drawRobot(bQuery, qA, "var(--a)", "A");
    if (qB !== null) drawRobot(bQuery, qB, "var(--b)", "B");
  }
  bQuery.svg.addEventListener("click", ev => {
    const cell = ev.target;
    if (!cell || cell.dataset === undefined || cell.dataset.r === undefined) return;
    const r = Number(cell.dataset.r), c = Number(cell.dataset.c);
    if (r >= RS || c >= CS) return;
    const idx = r * CS + c;
    if (!VALID.has(idx)) return;
    if (qA === null || qB !== null) { qA = idx; qB = null; }
    else if (idx !== qA && !overlap(qA, idx)) { qB = idx; }
    renderQuery();
  });
  document.getElementById("q-start").addEventListener("click", () => { qA = D.start.a; qB = D.start.b; renderQuery(); });
  document.getElementById("q-clear").addEventListener("click", () => { qA = null; qB = null; renderQuery(); });
  renderQuery();

  </script>
</main>
</body>
</html>
