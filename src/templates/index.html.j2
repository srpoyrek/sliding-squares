<!doctype html>
{#
  Global index over every run.json under plots/tests/.
  Rendered by src.report.write_global_index with: rows (list of dicts).
  Autoescaping is on, so test names and error text are safe to interpolate.
#}
<meta charset="utf-8">
<title>sliding-squares — all tests</title>
<style>
 :root{--bg:#fff;--fg:#1a1a1a;--muted:#666;--line:#ddd;--ok:#1a7f37;--bad:#b3261e;--card:#fafafa}
 @media (prefers-color-scheme:dark){:root{--bg:#24262b;--fg:#f2f2f2;--muted:#a9adb5;
       --line:#3d414a;--card:#2d3038;--ok:#4ac26b;--bad:#f4776a}}
 /* Charts keep a light face in both themes: the axes, guides and value labels
    are tuned for dark-on-light, and a chart that inverts with the page is not
    comparable with one screenshotted from the other theme. */
 .chart text{fill:#5b616b} .chart .grid{stroke:#e3e6ea} .chart .axis{stroke:#9aa0a8}
 body{margin:0;padding:24px;background:var(--bg);color:var(--fg);
      font:14px/1.5 ui-sans-serif,system-ui,sans-serif}
 h1{font-size:20px;margin:0 0 12px}
 table{border-collapse:collapse;width:100%;display:block;overflow-x:auto}
 th,td{border-bottom:1px solid var(--line);padding:7px 12px;text-align:left;white-space:nowrap}
 th{color:var(--muted);font-weight:600}
 tr:hover td{background:var(--card)}
 a{color:inherit} .muted{color:var(--muted)}
 .ok{color:var(--ok);font-weight:600} .bad{color:var(--bad);font-weight:600}
 .strip{display:flex;flex-wrap:wrap;gap:18px;align-items:flex-start}
 .strip figure{background:var(--card);border:1px solid var(--line);
               border-radius:7px;padding:12px}
 :root{--a:{{ palette.a }};--b:{{ palette.b }}}
</style>

<h1>sliding-squares — all tests</h1>
<p class="muted">{{ rows | length }} run(s). <b>Best recipe</b> lists every
recipe that left the fewest walls while preserving the switch count — all of
them when they tie, ordered so the result with more walls freed by the placement
rule comes first, since those are lossless by construction rather than merely
verified on this workspace.</p>

<table>
  <tr>
    <th>test</th><th>grid</th><th>robot</th><th>control turns</th>
    <th>steps</th><th>recipes</th><th>best recipe</th><th>walls</th><th>generated</th>
  </tr>
  {% for row in rows %}
  {% if row.error %}
  <tr>
    <td>{{ row.folder }}</td>
    <td colspan="8" class="bad">unreadable: {{ row.error }}</td>
  </tr>
  {% else %}
  <tr>
    <td><a href="{{ row.folder }}/{{ report_filename }}">{{ row.name }}</a></td>
    <td>{{ row.rows }}x{{ row.cols }}</td>
    <td>{{ row.n }}x{{ row.n }}</td>
    <td>{{ row.switches }}</td>
    <td>{{ row.steps }}</td>
    <td>
      {%- if row.recipe_total -%}
        <span class="ok">{{ row.recipe_kept }}</span>/{{ row.recipe_total }} preserved
      {%- else -%}
        <span class="muted">-</span>
      {%- endif -%}
    </td>
    {# Every recipe that reached the fewest walls while preserving the switch
       count — all of them when they tie, most-provable first. #}
    <td style="white-space:normal">
      {%- if row.best -%}
        {%- for r in row.best.recipes -%}
          {%- if not loop.first %}<br>{% endif -%}
          {%- if r.href -%}
            <a href="{{ row.folder }}/{{ r.href }}"><b>{{ r.mode }}</b></a>
          {%- else -%}
            <b>{{ r.mode }}</b>
          {%- endif -%}
        {%- endfor -%}
        {%- if row.best.recipes | length > 1 %}
        <br><span class="muted">{{ row.best.recipes | length }}-way tie</span>
        {%- endif -%}
      {%- else -%}
        <span class="muted">none preserved</span>
      {%- endif -%}
    </td>
    <td>
      {%- if row.best -%}
        {{ row.best.walls_before }}&rarr;{{ row.best.walls_after }}
        <span class="ok">&minus;{{ row.best.pct }}%</span>
      {%- else -%}
        <span class="muted">-</span>
      {%- endif -%}
    </td>
    <td class="muted">{{ row.generated }}</td>
  </tr>
  {% endif %}
  {% endfor %}
</table>

<h2 style="font-size:17px;margin:32px 0 4px">Robot size vs difficulty</h2>
<p class="muted" style="margin:0 0 12px">Each test as a point, split by whether
the workspace has interior holes. <b>Switches</b> is what the solver proved
minimal; <b>obstacles after</b> is the fewest walls any recipe reached while
still costing that same number of switches.</p>
<div class="strip" id="charts"></div>

<h2 style="font-size:17px;margin:32px 0 4px">Solve cost vs robot size</h2>
<p class="muted" style="margin:0 0 12px">How the cost of <em>solving</em> grows
with robot size — every recipe and the original on the same axes, so their
curves can be compared directly. Solid lines and filled dots are the no-holes
tests, dashed lines and hollow dots the holes tests. The vertical axis is
logarithmic: the cases span four orders of magnitude, and a linear axis would
flatten every small grid to nothing. A recipe appears only on the tests it held.
Hover a dot for its exact value.</p>
<div class="strip" id="costsize"></div>

<script type="application/json" id="pts">{{ chart_json | safe }}</script>
<script type="application/json" id="modes">{{ modes_json | safe }}</script>
{% raw %}
<script>
const PTS = JSON.parse(document.getElementById('pts').textContent);
const MODES = JSON.parse(document.getElementById('modes').textContent);

// Small scatter+line chart. Inline SVG rather than a library: the page has to
// stay self-contained and openable straight from disk.
// Ticks must be whole numbers AND sit exactly where their label says. Dividing
// the data maximum into four put a gridline at 3.25 and labelled it "3", so
// every point appeared to miss its own axis value. Rounding the top up to a
// multiple of four instead makes each tick an integer at its true position.
function niceTop(max){
  if(max <= 4) return Math.max(1, Math.ceil(max));
  return Math.ceil(max / 4) * 4;
}

function chart(title, yKey, yLabel){
  const pts = PTS.filter(p => p[yKey] !== null && p[yKey] !== undefined);
  if(!pts.length) return '';
  const W = 440, H = 300, L = 54, R = 18, T = 18, B = 46;
  const xs = pts.map(p => p.n), ys = pts.map(p => p[yKey]);
  const x0 = Math.min(...xs), x1 = Math.max(...xs);
  const top = niceTop(Math.max(...ys));
  const ticks = top <= 4 ? top : 4;
  const px = n => L + (x1 === x0 ? (W-L-R)/2 : (n - x0) / (x1 - x0) * (W - L - R));
  const py = v => H - B - v / top * (H - T - B);
  const out = [`<svg class="chart" viewBox="0 0 ${W} ${H}" width="${W}"
    height="${H}" role="img">`,
    // Painted as a rect, not a CSS background: a CSS background on an inline
    // SVG is not reliably rendered, and the chart has to stay white whatever
    // the page theme is.
    `<rect x="0" y="0" width="${W}" height="${H}" fill="#ffffff" rx="6"/>`];

  for(let i = 0; i <= ticks; i++){
    const v = Math.round(top * i / ticks), y = py(v);
    out.push(`<line class="grid" x1="${L}" y1="${y}" x2="${W-R}" y2="${y}"
      stroke-width="1"/><text x="${L-8}" y="${y}" font-size="11"
      text-anchor="end" dominant-baseline="central">${v}</text>`);
  }
  // Vertical guide per robot size, so a point's x is readable too.
  for(let n = x0; n <= x1; n++){
    out.push(`<line class="grid" x1="${px(n)}" y1="${T}" x2="${px(n)}" y2="${H-B}"
      stroke-width="1" stroke-dasharray="2 3"/>`);
    out.push(`<text x="${px(n)}" y="${H-B+17}" font-size="11"
      text-anchor="middle">${n}&times;${n}</text>`);
  }
  out.push(`<line class="axis" x1="${L}" y1="${T}" x2="${L}" y2="${H-B}"
    stroke-width="1"/><line class="axis" x1="${L}" y1="${H-B}" x2="${W-R}"
    y2="${H-B}" stroke-width="1"/>`);
  out.push(`<text x="${(L+W-R)/2}" y="${H-7}" font-size="11"
    text-anchor="middle">robot size</text>`);
  out.push(`<text x="14" y="${(T+H-B)/2}" font-size="11" text-anchor="middle"
    transform="rotate(-90 14 ${(T+H-B)/2})">${yLabel}</text>`);

  for(const [holes, colour] of [[false,'var(--a)'],[true,'var(--b)']]){
    const s = pts.filter(p => p.holes === holes).sort((a,b) => a.n - b.n);
    if(!s.length) continue;
    // Stepped, not a direct join. Robot size is discrete, so a diagonal between
    // two sizes draws values at fractional n that do not exist; holding each
    // value flat until the next size and stepping there states only what was
    // measured.
    const step = [];
    s.forEach((p, i) => {
      const x = px(p.n), y = py(p[yKey]);
      if(i) step.push(`${x},${py(s[i-1][yKey])}`);
      step.push(`${x},${y}`);
    });
    out.push(`<polyline points="${step.join(' ')}" fill="none" stroke="${colour}"
      stroke-width="2.5" stroke-linejoin="miter" stroke-linecap="butt"/>`);
    for(const p of s){
      out.push(`<circle cx="${px(p.n)}" cy="${py(p[yKey])}" r="5" fill="${colour}"
        stroke="#fff" stroke-width="1.5"><title>${p.name}: ${p[yKey]} ${yLabel}</title></circle>`);
      // The value beside each point, so the chart is readable without hovering.
      out.push(`<text x="${px(p.n)}" y="${py(p[yKey]) - 11}" font-size="11"
        font-weight="700" fill="${colour}" text-anchor="middle">${p[yKey]}</text>`);
    }
  }
  out.push('</svg>');
  const key = (c, t) => `<span style="display:inline-flex;align-items:center;gap:5px">
    <i style="width:11px;height:11px;border-radius:50%;background:${c};display:inline-block"></i>${t}</span>`;
  return `<figure style="margin:0"><b style="font-size:13px">${title}</b>${out.join('')}
    <figcaption style="display:flex;gap:14px;font-size:12px;color:var(--muted)">
    ${key('var(--a)','no holes')}${key('var(--b)','holes')}</figcaption></figure>`;
}

document.getElementById('charts').innerHTML =
  chart('Minimum control turns', 'switches', 'control turns') +
  chart('Obstacles after simplification', 'walls_after', 'walls left');

// ── solve cost vs robot size, all series overlaid ──
// Same unit rules as everywhere else on the site.
const fmtSecs = s => s < 1e-3 ? (s*1e6).toFixed(1)+'us' : s < 1 ? (s*1e3).toFixed(1)+'ms' : s.toFixed(2)+'s';
const fmtK = v => v.toLocaleString();
// The same palette, in the same sorted-mode order, as the per-test chart above
// -- so a recipe is one colour everywhere on the page. The original is black.
const SERIES_COLOURS = ['#2f6fd0','#d9822b','#2a9d5c','#8e44ad','#c0392b','#7f8c8d','#16a085'];
const seriesColour = m => m === 'original' ? '#1a1a1a'
  : SERIES_COLOURS[MODES.indexOf(m) % SERIES_COLOURS.length];

// One chart, every series on it. Log y with a gridline per decade; the point
// values are on hover rather than printed, since ten lines' worth of labels
// would bury the curves. Solid/filled = no holes, dashed/hollow = holes, so
// the two families stay apart even where colours are close.
function overlay(title, prefix, yLabel, fmt){
  const series = ['original', ...MODES];
  const all = [];
  for(const p of PTS) for(const m of series){ const v = p[prefix+m]; if(v != null && v > 0) all.push(v); }
  if(!all.length) return '';
  const W = 660, H = 340, L = 66, R = 18, T = 18, B = 46;
  const xs = PTS.map(p => p.n), x0 = Math.min(...xs), x1 = Math.max(...xs);
  const lo = Math.floor(Math.log10(Math.min(...all)));
  const hiRaw = Math.ceil(Math.log10(Math.max(...all))), hi = hiRaw > lo ? hiRaw : lo + 1;
  const px = n => L + (x1 === x0 ? (W-L-R)/2 : (n - x0) / (x1 - x0) * (W - L - R));
  const py = v => H - B - (Math.log10(v) - lo) / (hi - lo) * (H - T - B);
  const out = [`<svg class="chart" viewBox="0 0 ${W} ${H}" width="${W}" height="${H}" role="img">`,
    `<rect x="0" y="0" width="${W}" height="${H}" fill="#ffffff" rx="6"/>`];
  for(let e = lo; e <= hi; e++){
    const v = Math.pow(10, e), y = py(v);
    out.push(`<line class="grid" x1="${L}" y1="${y}" x2="${W-R}" y2="${y}" stroke-width="1"/>
      <text x="${L-8}" y="${y}" font-size="11" text-anchor="end" dominant-baseline="central">${fmt(v)}</text>`);
  }
  for(let n = x0; n <= x1; n++){
    out.push(`<line class="grid" x1="${px(n)}" y1="${T}" x2="${px(n)}" y2="${H-B}" stroke-width="1" stroke-dasharray="2 3"/>
      <text x="${px(n)}" y="${H-B+17}" font-size="11" text-anchor="middle">${n}&times;${n}</text>`);
  }
  out.push(`<line class="axis" x1="${L}" y1="${T}" x2="${L}" y2="${H-B}" stroke-width="1"/>
    <line class="axis" x1="${L}" y1="${H-B}" x2="${W-R}" y2="${H-B}" stroke-width="1"/>
    <text x="${(L+W-R)/2}" y="${H-7}" font-size="11" text-anchor="middle">robot size</text>
    <text x="14" y="${(T+H-B)/2}" font-size="11" text-anchor="middle"
      transform="rotate(-90 14 ${(T+H-B)/2})">${yLabel} (log)</text>`);
  for(const m of series){
    const colour = seriesColour(m), k = prefix + m;
    for(const holes of [false, true]){
      const s = PTS.filter(p => p.holes === holes && p[k] != null && p[k] > 0).sort((a,b) => a.n - b.n);
      if(!s.length) continue;
      // Stepped, as the charts above: robot size is discrete, and a diagonal
      // would draw values at sizes that do not exist.
      const step = [];
      s.forEach((p, i) => {
        const x = px(p.n), y = py(p[k]);
        if(i) step.push(`${x},${py(s[i-1][k])}`);
        step.push(`${x},${y}`);
      });
      out.push(`<polyline points="${step.join(' ')}" fill="none" stroke="${colour}" stroke-width="2"
        ${holes ? 'stroke-dasharray="6 4"' : ''} stroke-linejoin="miter" stroke-linecap="butt"/>`);
      for(const p of s)
        out.push(`<circle cx="${px(p.n)}" cy="${py(p[k])}" r="3.5" fill="${holes ? '#fff' : colour}"
          stroke="${colour}" stroke-width="2"><title>${p.name} · ${m}: ${fmt(p[k])} ${yLabel}</title></circle>`);
    }
  }
  out.push('</svg>');
  const sw = (c, t) => `<span style="display:inline-flex;align-items:center;gap:5px">
    <i style="width:14px;height:3px;background:${c};display:inline-block"></i>${t}</span>`;
  return `<figure style="margin:0"><b style="font-size:13px">${title}</b>${out.join('')}
    <figcaption style="display:flex;flex-wrap:wrap;gap:12px;font-size:12px;color:var(--muted)">
    ${series.map(m => sw(seriesColour(m), m)).join('')}
    <span>&mdash;&mdash; no holes &nbsp; - - - holes</span></figcaption></figure>`;
}

document.getElementById('costsize').innerHTML =
  overlay('Solve time vs robot size', 'time__', 'seconds', fmtSecs) +
  overlay('States held vs robot size', 'states__', 'states', fmtK);
</script>
{% endraw %}

{% if cost_charts %}
<h2 style="font-size:17px;margin:32px 0 4px">Solve cost after simplification, per test</h2>
<p class="muted" style="margin:0 0 12px">For every test, what each recipe did to
the cost of <em>solving</em> — its re-solve as a multiple of that test's original
solve. The dashed line is <b>&plusmn;0%</b>, unchanged; a bar ending left of it
is a cheaper solve, and negative is better. A hollow bar is a recipe that
<b>failed</b> on that test: its solve is cheaper because it changed the problem,
not because it simplified it. States going <em>up</em> after simplification is
expected — fewer walls means more positions to search — while time can still
fall because the cropped grid makes every flood fill cheaper.</p>
<div class="strip">
{% for ch in cost_charts %}
<figure style="margin:0">
  <b style="font-size:13px">{{ ch.title }}</b>
  <svg class="chart" viewBox="0 0 {{ ch.width }} {{ ch.height }}" width="{{ ch.width }}"
       height="{{ ch.height }}" role="img" aria-label="{{ ch.title }}, per test and recipe">
    <rect x="0" y="0" width="{{ ch.width }}" height="{{ ch.height }}" fill="#ffffff" rx="6"/>
    <line class="axis" x1="{{ ch.ref_x }}" y1="14" x2="{{ ch.ref_x }}" y2="{{ ch.height - 4 }}"
          stroke-dasharray="3 3" stroke-width="1"/>
    <text x="{{ ch.ref_x }}" y="11" font-size="11" text-anchor="middle">&plusmn;0%</text>
    <text x="{{ ch.bar_x }}" y="11" font-size="10">{{ ch.axis }}</text>
    {% for g in ch.groups %}
    <text x="0" y="{{ g.heading_y }}" font-size="12" font-weight="700">{{ g.name }}</text>
    {% for b in g.bars %}
    <text x="{{ ch.bar_x - 8 }}" y="{{ b.y + 10 }}" font-size="10" text-anchor="end"
          fill="{{ b.fill }}">{{ b.mode }}</text>
    {% if b.w %}
    <rect x="{{ ch.bar_x }}" y="{{ b.y }}" width="{{ b.w }}" height="{{ ch.bar_h }}" rx="2"
          {% if b.held %}fill="{{ b.fill }}"{% else %}fill="none" stroke="{{ b.fill }}" stroke-width="1.5"{% endif %}/>
    {% endif %}
    <text x="{{ ch.bar_x + b.w + 6 }}" y="{{ b.y + 10 }}" font-size="10"
          >{{ b.label }}{% if not b.held %} <tspan font-weight="700">FAILED</tspan>{% endif %}</text>
    {% endfor %}
    {% endfor %}
  </svg>
  <figcaption style="display:flex;flex-wrap:wrap;gap:12px;font-size:12px;color:var(--muted)">
    {% for l in ch.legend %}
    <span style="display:inline-flex;align-items:center;gap:5px"><i style="width:11px;height:11px;border-radius:2px;background:{{ l.fill }};display:inline-block"></i>{{ l.mode }}</span>
    {% endfor %}
  </figcaption>
</figure>
{% endfor %}
</div>
{% endif %}

{% if leaderboard %}
<h2 style="font-size:17px;margin:32px 0 4px">Recipes ranked</h2>
<p class="muted" style="margin:0 0 12px">Across every test, strongest reduction
first. Averaged only over the runs where a recipe <em>held</em> — counting a
failed run would reward it, since a broken workspace is the smallest of all.</p>
<table>
  <tr>
    <th>#</th><th>recipe</th><th>avg reduction</th><th>preserved</th>
    <th>best on</th><th></th>
    <th>solve time vs original</th><th>states held vs original</th>
  </tr>
  {% for r in leaderboard %}
  <tr>
    <td class="muted">{{ loop.index }}</td>
    <td><b>{{ r.mode }}</b></td>
    <td><span class="ok">&minus;{{ r.avg_pct }}%</span></td>
    <td>{{ r.kept }}/{{ r.runs }}</td>
    <td>{{ r.wins }} test(s)</td>
    <td>
      {%- if r.always_held -%}
        <span class="ok">never failed</span>
      {%- else -%}
        <span class="bad">failed {{ r.runs - r.kept }}</span>
      {%- endif -%}
    </td>
    {# Geometric mean over the runs the recipe held; negative is cheaper. #}
    <td><span class="{{ 'ok' if r.time_ratio and r.time_ratio < 0.995 else ('bad' if r.time_ratio and r.time_ratio > 1.005 else 'muted') }}">{{ r.time_ratio | change }}</span></td>
    <td><span class="{{ 'ok' if r.states_ratio and r.states_ratio < 0.995 else ('bad' if r.states_ratio and r.states_ratio > 1.005 else 'muted') }}">{{ r.states_ratio | change }}</span></td>
  </tr>
  {% endfor %}
</table>
<p class="muted" style="margin:8px 0 0">The two cost columns are geometric means
over the runs each recipe held. <b>Expect them to disagree:</b> removing walls
opens the grid, so the search visits <em>more</em> positions for the same answer
and states usually rise; but the recipes also crop the grid, and every flood fill
scans its legal positions, so each step gets cheaper and time can fall. Both are
measured process-warm with no floods cached for the grid being solved.</p>
{% endif %}
