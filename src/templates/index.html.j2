<!doctype html>
{#
  Global index over every run.json under plots/tests/.
  Rendered by src.report.write_global_index with: rows (list of dicts).
  Autoescaping is on, so test names and error text are safe to interpolate.
#}
<meta charset="utf-8">
<title>sliding-squares — all tests</title>
<style>
 :root{--bg:#fff;--fg:#1a1a1a;--muted:#666;--line:#ddd;--ok:#1a7f37;--bad:#b3261e;--card:#fafafa}
 @media (prefers-color-scheme:dark){:root{--bg:#24262b;--fg:#f2f2f2;--muted:#a9adb5;
       --line:#3d414a;--card:#2d3038;--ok:#4ac26b;--bad:#f4776a}}
 body{margin:0;padding:24px;background:var(--bg);color:var(--fg);
      font:14px/1.5 ui-sans-serif,system-ui,sans-serif}
 h1{font-size:20px;margin:0 0 12px}
 table{border-collapse:collapse;width:100%;display:block;overflow-x:auto}
 th,td{border-bottom:1px solid var(--line);padding:7px 12px;text-align:left;white-space:nowrap}
 th{color:var(--muted);font-weight:600}
 tr:hover td{background:var(--card)}
 a{color:inherit} .muted{color:var(--muted)}
 .ok{color:var(--ok);font-weight:600} .bad{color:var(--bad);font-weight:600}
</style>

<h1>sliding-squares — all tests</h1>
<p class="muted">{{ rows | length }} run(s). <b>Best recipe</b> lists every
recipe that left the fewest walls while preserving the switch count — all of
them when they tie, ordered so the result with more walls freed by the placement
rule comes first, since those are lossless by construction rather than merely
verified on this workspace.</p>

<table>
  <tr>
    <th>test</th><th>grid</th><th>robot</th><th>switches</th>
    <th>steps</th><th>recipes</th><th>best recipe</th><th>walls</th><th>generated</th>
  </tr>
  {% for row in rows %}
  {% if row.error %}
  <tr>
    <td>{{ row.folder }}</td>
    <td colspan="8" class="bad">unreadable: {{ row.error }}</td>
  </tr>
  {% else %}
  <tr>
    <td><a href="{{ row.folder }}/{{ report_filename }}">{{ row.name }}</a></td>
    <td>{{ row.rows }}x{{ row.cols }}</td>
    <td>{{ row.n }}x{{ row.n }}</td>
    <td>{{ row.switches }}</td>
    <td>{{ row.steps }}</td>
    <td>
      {%- if row.recipe_total -%}
        <span class="ok">{{ row.recipe_kept }}</span>/{{ row.recipe_total }} preserved
      {%- else -%}
        <span class="muted">-</span>
      {%- endif -%}
    </td>
    {# Every recipe that reached the fewest walls while preserving the switch
       count — all of them when they tie, most-provable first. #}
    <td style="white-space:normal">
      {%- if row.best -%}
        {%- for r in row.best.recipes -%}
          {%- if not loop.first %}<br>{% endif -%}
          {%- if r.href -%}
            <a href="{{ row.folder }}/{{ r.href }}"><b>{{ r.mode }}</b></a>
          {%- else -%}
            <b>{{ r.mode }}</b>
          {%- endif -%}
        {%- endfor -%}
        {%- if row.best.recipes | length > 1 %}
        <br><span class="muted">{{ row.best.recipes | length }}-way tie</span>
        {%- endif -%}
      {%- else -%}
        <span class="muted">none preserved</span>
      {%- endif -%}
    </td>
    <td>
      {%- if row.best -%}
        {{ row.best.walls_before }}&rarr;{{ row.best.walls_after }}
        <span class="ok">&minus;{{ row.best.pct }}%</span>
      {%- else -%}
        <span class="muted">-</span>
      {%- endif -%}
    </td>
    <td class="muted">{{ row.generated }}</td>
  </tr>
  {% endif %}
  {% endfor %}
</table>

{% if leaderboard %}
<h2 style="font-size:17px;margin:32px 0 4px">Recipes ranked</h2>
<p class="muted" style="margin:0 0 12px">Across every test, strongest reduction
first. Averaged only over the runs where a recipe <em>held</em> — counting a
failed run would reward it, since a broken workspace is the smallest of all.</p>
<table>
  <tr>
    <th>#</th><th>recipe</th><th>avg reduction</th><th>preserved</th>
    <th>best on</th><th></th>
  </tr>
  {% for r in leaderboard %}
  <tr>
    <td class="muted">{{ loop.index }}</td>
    <td><b>{{ r.mode }}</b></td>
    <td><span class="ok">&minus;{{ r.avg_pct }}%</span></td>
    <td>{{ r.kept }}/{{ r.runs }}</td>
    <td>{{ r.wins }} test(s)</td>
    <td>
      {%- if r.always_held -%}
        <span class="ok">never failed</span>
      {%- else -%}
        <span class="bad">failed {{ r.runs - r.kept }}</span>
      {%- endif -%}
    </td>
  </tr>
  {% endfor %}
</table>
{% endif %}
