<!doctype html>
{# Aggregator over plots/building_blocks/n*/index.html — written by
   report._write_building_blocks_index() only when the series was run one
   robot size at a time, so there is no single report to link to directly. #}
<meta charset="utf-8">
<title>sliding-squares — building blocks</title>
<style>
 :root{--bg:#fff;--fg:#1a1a1a;--muted:#666;--line:#ddd;--card:#fafafa}
 @media (prefers-color-scheme:dark){:root{--bg:#24262b;--fg:#f2f2f2;--muted:#a9adb5;
       --line:#3d414a;--card:#2d3038}}
 body{margin:0;padding:40px 24px;background:var(--bg);color:var(--fg);
      font:15px/1.6 ui-sans-serif,system-ui,sans-serif;max-width:640px}
 h1{font-size:22px;margin:0 0 6px}
 a.back{color:var(--muted);text-decoration:none;font-size:14px}
 a.card{display:block;background:var(--card);border:1px solid var(--line);
        border-radius:8px;padding:14px 16px;margin:12px 0;color:inherit;
        text-decoration:none}
 a.card:hover{border-color:var(--muted)}
 a.card b{display:block;font-size:16px}
 .muted{color:var(--muted)}
</style>

<p><a class="back" href="../{{ report_filename }}">&larr; back</a></p>
<h1>Building blocks</h1>
<p class="muted">One report per robot size.</p>

{% for link in links %}
<a class="card" href="{{ link }}/{{ report_filename }}"><b>{{ link }}</b></a>
{% endfor %}

<p class="muted">Built {{ generated }}</p>
