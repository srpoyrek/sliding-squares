<!doctype html>
{#
  Per-test report. Rendered by src.report.write_local_report with:
    title     the test name (autoescaped by Jinja)
    run_json  the run record, already JSON-encoded and </-escaped

  The JSON is inlined rather than fetched because browsers refuse fetch() over
  file://, and the point of this page is that it opens by double-click.

  The <style> and <script> bodies are wrapped in {% raw %} so Jinja leaves the
  CSS braces and JS template literals alone.
#}
<meta charset="utf-8">
<title>{{ title }}</title>
{% raw %}
<style>
 /* Page chrome only -- the board palette is emitted below from visualizer.py.
    The board keeps one palette in both themes: a diagram that inverts with the
    page is harder to compare against the PNGs, so only the chrome follows it. */
 :root{--bg:#ffffff;--fg:#1a1a1a;--muted:#666;--line:#ddd;--ok:#1a7f37;
       --bad:#b3261e;--card:#fafafa}
 @media (prefers-color-scheme:dark){:root{--bg:#24262b;--fg:#f2f2f2;--muted:#a9adb5;
       --line:#3d414a;--card:#2d3038;--ok:#4ac26b;--bad:#f4776a}}
 body{margin:0;padding:24px;background:var(--bg);color:var(--fg);
      font:14px/1.5 ui-sans-serif,system-ui,sans-serif}
 h1{font-size:20px;margin:0 0 4px} h2{font-size:15px;margin:28px 0 10px}
 .muted{color:var(--muted)} a{color:inherit}
 .stats{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0}
 .stat{background:var(--card);border:1px solid var(--line);border-radius:6px;padding:6px 10px}
 .stat b{font-variant-numeric:tabular-nums}
 .controls{display:flex;gap:6px;align-items:center;margin:10px 0;flex-wrap:wrap}
 .path{display:flex;flex-wrap:wrap;gap:4px;align-items:center;margin:10px 0}
 .seg{background:var(--card);border:1px solid var(--line);border-radius:5px;
      padding:3px 8px;font-family:ui-monospace,monospace;font-size:13px}
 .seg b{color:var(--muted);font-weight:600;margin-right:5px}
 .sw{color:var(--muted);font-weight:700;font-size:12px}
 tr.pick{cursor:pointer} tr.pick:hover td{background:var(--card)}
 tr.on td{background:var(--card);box-shadow:inset 3px 0 0 var(--a)}
 select{font:inherit;padding:4px 8px;border:1px solid var(--line);border-radius:5px;
        background:var(--card);color:inherit}
 button{font:inherit;padding:4px 10px;border:1px solid var(--line);border-radius:5px;
        background:var(--card);color:inherit;cursor:pointer}
 button:hover{border-color:var(--muted)}
 input[type=range]{width:260px}
 .strip{display:flex;flex-wrap:wrap;gap:12px}
 .cell{background:var(--card);border:1px solid var(--line);border-radius:6px;padding:8px}
 .cell figcaption{font-size:12px;color:var(--muted);margin-top:4px;text-align:center}
 table{border-collapse:collapse;width:100%;overflow-x:auto;display:block}
 th,td{border-bottom:1px solid var(--line);padding:6px 10px;text-align:left;white-space:nowrap}
 th{font-weight:600;color:var(--muted)}
 .ok{color:var(--ok);font-weight:600}.bad{color:var(--bad);font-weight:600}
</style>
{% endraw %}
{# Board palette, straight from visualizer.py's constants -- declared after the
   block above so it wins, and defined in exactly one place in the codebase. #}
<style>
 :root{--wall:{{ palette.wall }};--free:{{ palette.free }};--grid:{{ palette.grid }};
       --a:{{ palette.a }};--b:{{ palette.b }};--arrow-a:{{ palette.arrow_a }};
       --arrow-b:{{ palette.arrow_b }};--hot:{{ palette.hot }};--label:{{ palette.label }}}
</style>

<h1>{{ title }}</h1>
<div class="muted" id="sub"></div>
<div class="stats" id="stats"></div>
<div class="path" id="pathbox"></div>

<h2>Transitions</h2>
<div id="player"></div>

<h2 id="cmphead">Side by side</h2>
<p class="muted" id="cmphint">Pick any two of the original and its simplified
variants. Both step together, so the same switch number is shown on each.</p>
<div class="controls" id="cmppick">
  <select id="cmpL"></select><span class="muted">vs</span><select id="cmpR"></select>
</div>
<div class="strip" id="cmpboards"></div>
<div class="controls" id="cmpctl">
  <button data-a="prev">&larr;</button><button data-a="play">Play</button>
  <button data-a="next">&rarr;</button>
  <input type="range" id="cmpscrub" min="0" value="0">
  <span class="muted" id="cmppos"></span>
</div>
<div class="strip" id="cmpheat"></div>

<h2>Every switch</h2>
<div class="strip" id="turns"></div>

<h2 id="hhead">Blocker heatmap</h2>
<p class="muted" id="hhint">How often each wall was in contact with a robot face.
Shaded walls are load-bearing; unshaded ones were never touched, and are what
the contact-driven recipes remove first.</p>
<div id="heat"></div>

<h2 id="rhead">Simplification recipes</h2>
<p class="muted" id="rhint">Click a recipe to play its own solution.</p>
<div id="recipes"></div>
<div id="rplayer"></div>

<p class="muted"><a href="{{ parent_href }}">&larr; back</a> &middot;
<span id="gen"></span></p>

{# `safe`: the payload is already JSON. Autoescaping it would turn every quote
   into &#34;, and a <script> body is raw text -- the browser never decodes
   entities there, so JSON.parse would fail. report.py neutralises the only
   real hazard, a literal "</" closing the block early. #}
<script type="application/json" id="run">{{ run_json | safe }}</script>
{% raw %}
<script>
// A thrown error stops every later statement, silently losing whole sections of
// the page. Surface it instead of leaving a half-rendered report looking whole.
addEventListener('error', ev => {
  document.body.insertAdjacentHTML('afterbegin',
    `<p class="bad">Report script error: ${ev.message} — sections below this point
     may be missing.</p>`);
});

const RUN = JSON.parse(document.getElementById('run').textContent);
const G = RUN.grid, LAB = RUN.labels, CELL = 22;

// One SVG per board, drawn straight from the wall bitstring -- no image step,
// so a frame costs a string concat rather than a matplotlib render.
// `opts.path` is the turn's waypoint centers and `opts.color` the mover's colour.
function board(walls, rows, cols, a, b, size, opts={}){
  const s = opts.cell || CELL, W = cols*s, H = rows*s, p = [];
  p.push(`<svg viewBox="0 0 ${W} ${H}" width="${W}" height="${H}" role="img">`);
  for(let r=0;r<rows;r++) for(let c=0;c<cols;c++){
    const wall = walls[r*cols+c] === '1';
    p.push(`<rect x="${c*s}" y="${r*s}" width="${s}" height="${s}"
      fill="${wall?'var(--wall)':'var(--free)'}" stroke="var(--grid)" stroke-width=".5"/>`);
  }
  // Layering follows visualizer._draw_turn exactly: wall highlights, then the
  // faded ghost of where the mover started, then the robots, then the route on
  // top. Labels are drawn last -- the one deviation, so the arrow crossing a
  // square cannot hide which robot it is.
  const box = (pos, fill, op, lw) =>
    `<rect x="${pos[1]*s}" y="${pos[0]*s}" width="${size*s}" height="${size*s}"
      fill="${fill}" fill-opacity="${op}" stroke="#fff" stroke-width="${lw}"/>`;

  // Walls touched during this turn, shaded by how often (alpha .25 -> .75).
  if(opts.hits && opts.hits.length){
    const top = Math.max(...opts.hits.map(h => h[2])) || 1;
    for(const [r,c,n] of opts.hits)
      p.push(`<rect x="${c*s}" y="${r*s}" width="${s}" height="${s}" fill="var(--hot)"
        fill-opacity="${(0.25 + 0.50*(n/top)).toFixed(3)}"/>`);
  }
  if(opts.ghost) p.push(box(opts.ghost, opts.color2 || 'var(--a)', .25, 1));
  if(a) p.push(box(a, 'var(--a)', a === opts.mover ? .90 : .85, 2));
  if(b) p.push(box(b, 'var(--b)', b === opts.mover ? .90 : .85, 2));

  // The route, on top, with the head only on the final leg -- as the PNG does.
  if(opts.path && opts.path.length > 1){
    const pts = opts.path.map(([x,y]) => [x*s, y*s]);
    // Proportions taken from the PNGs rather than guessed. There ARROW_LW is 3
    // POINTS at dpi=150 on a ~105px cell, i.e. about 0.055 of a cell -- a thin
    // line, not the heavy one a naive pixel conversion produces.
    const lw = Math.max(1.5, 0.055 * size * s);
    if(pts.length > 2)
      p.push(`<polyline points="${pts.slice(0,-1).map(q=>q.join(',')).join(' ')}"
        fill="none" stroke="${opts.color}" stroke-width="${lw}" stroke-linecap="round"
        stroke-linejoin="round"/>`);
    // Head drawn as a polygon rather than a marker: marker fill cannot follow
    // the stroke colour reliably across browsers, and this scales with the robot
    // the way matplotlib's mutation_scale does.
    const [x0,y0] = pts[pts.length-2], [x1,y1] = pts[pts.length-1];
    const dx=x1-x0, dy=y1-y0, len=Math.hypot(dx,dy) || 1;
    // Head sized off the cell, not off the line width, so it stays a slim
    // triangle instead of the stubby wedge a lw-multiple gives.
    const ux=dx/len, uy=dy/len;
    const hl=Math.min(len*0.9, 0.26*size*s), hw=0.13*size*s;
    const bx=x1-ux*hl, by=y1-uy*hl;      // base of the head, back along the line
    p.push(`<line x1="${x0}" y1="${y0}" x2="${bx}" y2="${by}" stroke="${opts.color}"
      stroke-width="${lw}" stroke-linecap="butt"/>`);
    p.push(`<polygon points="${x1},${y1} ${bx-uy*hw},${by+ux*hw} ${bx+uy*hw},${by-ux*hw}"
      fill="${opts.color}"/>`);
  }

  const label = (pos, text) => pos ? `<text x="${(pos[1]+size/2)*s}"
    y="${(pos[0]+size/2)*s}" fill="var(--label)" stroke="rgba(0,0,0,.45)"
    stroke-width="${Math.max(.8,s*0.035)}" paint-order="stroke"
    font-size="${Math.max(11,s*0.72)}" font-weight="700" text-anchor="middle"
    dominant-baseline="central">${text}</text>` : '';
  p.push(label(a, LAB.a), label(b, LAB.b));
  p.push('</svg>');
  return p.join('');
}

const el = id => document.getElementById(id);

// Solve time is carried as seconds and given its unit here, so the page never
// shows a bare number whose scale you have to guess.
function duration(sec){
  if(sec == null) return '—';
  if(sec < 1e-3) return (sec*1e6).toFixed(1) + ' µs';
  if(sec < 1)    return (sec*1e3).toFixed(1) + ' ms';
  return sec.toFixed(2) + ' s';
}

el('sub').textContent = `${G.rows}x${G.cols} grid · ${RUN.meta.n}x${RUN.meta.n} robots`;
el('gen').textContent = RUN.meta.generated;
el('stats').innerHTML = [
  ['switches', RUN.meta.switches], ['turns', RUN.turns.length],
  ['moves', RUN.frames.length - 1], ['solve time', duration(RUN.meta.solver_seconds)],
].map(([k,v])=>`<span class="stat">${k} <b>${v}</b></span>`).join('');

// One entry per SWITCH, not per move: entry 0 is the start state, entry k is
// the board after turn k-1 with an arrow spanning that whole turn's movement.
// Stepping a move at a time made a long solve tedious to page through.
function switchSteps(seq){
  const f0 = seq.frames[0];
  const out = [{a: f0.a, b: f0.b, title: 'start', moves: '', path: null}];
  for(const t of seq.turns){
    const isA = t.label === LAB.a;
    const to = t.to;
    out.push({
      a: isA ? to : t.stationary,
      b: isA ? t.stationary : to,
      title: `switch ${String(t.layer).padStart(2,'0')} · ${t.label} moved · ${t.steps} moves`,
      moves: t.moves || '',
      path: t.waypoints,
      hits: t.hits,
      ghost: t.from,                       // faded start box, as in the PNG
      mover: to,                           // drawn at .90, the others at .85
      // visualizer uses a dedicated arrow colour per robot, distinct from the
      // robot's own fill, so the route stays readable across it.
      color: isA ? 'var(--arrow-a)' : 'var(--arrow-b)',
      color2: isA ? 'var(--a)' : 'var(--b)',
    });
  }
  return out;
}

// A self-contained player mounted into `host`, so the main solve and any recipe
// can each have one without the controls being tied to fixed element ids.
function makePlayer(host, grid, steps, size, cell){
  host.innerHTML = `<div class="board"></div>
    <div class="controls">
      <button data-a="prev">&larr;</button><button data-a="play">Play</button>
      <button data-a="next">&rarr;</button>
      <input type="range" min="0" value="0"><span class="muted pos"></span>
    </div><div class="muted cap"></div>`;
  const stage = host.querySelector('.board'), scrub = host.querySelector('input'),
        pos = host.querySelector('.pos'), cap = host.querySelector('.cap'),
        playBtn = host.querySelector('[data-a=play]');
  let i = 0, timer = null;
  scrub.max = steps.length - 1;
  function show(k){
    i = Math.max(0, Math.min(steps.length-1, k));
    const st = steps[i];
    stage.innerHTML = board(grid.walls, grid.rows, grid.cols, st.a, st.b, size,
      {cell, path: st.path, color: st.color, color2: st.color2,
       hits: st.hits, ghost: st.ghost, mover: st.mover});
    // The turn's own U/D/L/R sequence, so the moves behind the route are visible
    // rather than only its shape.
    cap.innerHTML = st.title
      + (st.moves ? ` &middot; <span class="seg">${st.moves}</span>` : '');
    pos.textContent = `${i} / ${steps.length-1} switches`;
    scrub.value = i;
  }
  host.querySelector('[data-a=next]').onclick = () => show(i+1);
  host.querySelector('[data-a=prev]').onclick = () => show(i-1);
  scrub.oninput = e => show(+e.target.value);
  playBtn.onclick = () => {
    if(timer){ clearInterval(timer); timer=null; playBtn.textContent='Play'; return; }
    playBtn.textContent = 'Pause';
    timer = setInterval(() => {
      if(i >= steps.length-1){ clearInterval(timer); timer=null; playBtn.textContent='Play'; return; }
      show(i+1);
    }, 700);
  };
  show(0);
  return {show, step: () => i};
}

const main = makePlayer(el('player'), G, switchSteps(RUN), RUN.meta.n, 46);
addEventListener('keydown', e => {
  if(e.key === 'ArrowRight'){ main.show(main.step()+1); e.preventDefault(); }
  if(e.key === 'ArrowLeft'){ main.show(main.step()-1); e.preventDefault(); }
});

// ── blocker heatmap ──
// Same scheme as visualizer.draw_blocker_heatmap, so page and PNG compare
// directly: #ff8800 over the black wall at opacity 0.3 + 0.6*(hits/max), white
// numerals, and a tick on each face that was hit. Untouched walls stay black.
function heatBoard(grid, heat, s){
  if(!heat || !heat.cells.length) return '<span class="muted">nothing touched</span>';
  const hot = new Map(heat.cells.map(([r,c,n]) => [r+','+c, n]));
  const peak = heat.max || 1;
  const p = [`<svg viewBox="0 0 ${grid.cols*s} ${grid.rows*s}" width="${grid.cols*s}"
    height="${grid.rows*s}" role="img">`];
  for(let r=0;r<grid.rows;r++) for(let c=0;c<grid.cols;c++){
    const wall = grid.walls[r*grid.cols+c] === '1';
    p.push(`<rect x="${c*s}" y="${r*s}" width="${s}" height="${s}"
      fill="${wall?'var(--wall)':'var(--free)'}" stroke="var(--grid)" stroke-width=".5"/>`);
    const n = hot.get(r+','+c) || 0;
    if(wall && n){
      p.push(`<rect x="${c*s}" y="${r*s}" width="${s}" height="${s}" fill="var(--hot)"
        fill-opacity="${(0.3 + 0.6*(n/peak)).toFixed(3)}"/>`);
      if(s >= 22) p.push(`<text x="${(c+.5)*s}" y="${(r+.5)*s}" font-size="${s*0.4}"
        font-weight="700" fill="#fff" text-anchor="middle"
        dominant-baseline="central">${n}</text>`);
    }
  }
  for(const [r,c,side] of (heat.faces || [])){
    const x0=c*s, y0=r*s, x1=(c+1)*s, y1=(r+1)*s;
    const seg = {N:[x0,y0,x1,y0], S:[x0,y1,x1,y1], W:[x0,y0,x0,y1], E:[x1,y0,x1,y1]}[side];
    if(seg) p.push(`<line x1="${seg[0]}" y1="${seg[1]}" x2="${seg[2]}" y2="${seg[3]}"
      stroke="var(--hot)" stroke-width="${Math.max(2,s*0.1)}" stroke-linecap="butt"/>`);
  }
  p.push('</svg>');
  return p.join('');
}

function heatSummary(heat){
  if(!heat || !heat.cells.length) return 'no wall contact';
  const total = heat.cells.reduce((t,[,,n]) => t+n, 0);
  return `${heat.cells.length} wall(s) touched · peak ${heat.max} · ${total} contacts`;
}

if(!RUN.heat || !RUN.heat.cells.length){
  for(const id of ['hhead','hhint','heat']) el(id).style.display = 'none';
} else {
  el('heat').innerHTML = heatBoard(G, RUN.heat, 40) +
    `<div class="muted" style="margin-top:6px">${heatSummary(RUN.heat)}</div>`;
}

// ── side-by-side comparison ──
// Every workspace this run produced, in one shape, so the panels can treat the
// original and a simplified variant identically.
const VARIANTS = [{
  key: 'original', label: 'original', grid: G, seq: RUN,
  switches: RUN.meta.switches,
  walls: [...G.walls].filter(ch => ch === '1').length,
}].concat(RUN.recipes.filter(r => r.sequence && r.grid).map(r => ({
  key: r.mode, label: r.mode + (r.preserved ? '' : ' (FAILED)'),
  grid: r.grid, seq: r.sequence, switches: r.new_switches, walls: r.walls_after,
})));

if(VARIANTS.length < 2){
  // Nothing to compare against — a plain solve with no recipes.
  for(const id of ['cmphead','cmphint','cmppick','cmpboards','cmpctl','cmpheat'])
    el(id).style.display = 'none';
} else {
  const opts = VARIANTS.map((v,i) => `<option value="${i}">${v.label}</option>`).join('');
  el('cmpL').innerHTML = opts; el('cmpR').innerHTML = opts;
  el('cmpL').value = 0;
  el('cmpR').value = 1;

  let ci = 0, ctimer = null;
  const sides = () => [VARIANTS[+el('cmpL').value], VARIANTS[+el('cmpR').value]];
  // Each side has its own step list; a FAILED recipe solves in fewer switches,
  // so the shorter one holds at its last state rather than the pair being
  // clamped to the shorter run.
  const stepsFor = v => switchSteps(v.seq);

  function panel(v, steps, i){
    const st = steps[Math.min(i, steps.length-1)];
    const done = i >= steps.length ? ' <span class="muted">(finished)</span>' : '';
    return `<figure class="cell" style="margin:0">
      ${board(v.grid.walls, v.grid.rows, v.grid.cols, st.a, st.b, RUN.meta.n,
              {cell:34, path: st.path, color: st.color, color2: st.color2,
               hits: st.hits, ghost: st.ghost, mover: st.mover})}
      <figcaption><b>${v.label}</b><br>${v.walls} walls · ${v.switches} switches<br>
      ${st.title}${done}${st.moves ? ` · <span class="seg">${st.moves}</span>` : ''}
      </figcaption></figure>`;
  }

  function drawCompare(){
    const [L, R] = sides(), sl = stepsFor(L), sr = stepsFor(R);
    const span = Math.max(sl.length, sr.length) - 1;
    el('cmpscrub').max = span;
    ci = Math.max(0, Math.min(span, ci));
    el('cmpscrub').value = ci;
    el('cmppos').textContent = `switch ${ci} / ${span}`;
    el('cmpboards').innerHTML = panel(L, sl, ci) + panel(R, sr, ci);
    // Heatmaps for the same pair: which walls each solution actually leans on.
    const hfig = v => `<figure class="cell" style="margin:0">
      ${heatBoard(v.grid, v.seq.heat, 26)}
      <figcaption><b>${v.label}</b><br>${heatSummary(v.seq.heat)}</figcaption></figure>`;
    el('cmpheat').innerHTML = hfig(L) + hfig(R);
  }

  el('cmpL').onchange = el('cmpR').onchange = drawCompare;
  el('cmpscrub').oninput = e => { ci = +e.target.value; drawCompare(); };
  el('cmpctl').querySelector('[data-a=next]').onclick = () => { ci++; drawCompare(); };
  el('cmpctl').querySelector('[data-a=prev]').onclick = () => { ci--; drawCompare(); };
  const cplay = el('cmpctl').querySelector('[data-a=play]');
  cplay.onclick = () => {
    if(ctimer){ clearInterval(ctimer); ctimer=null; cplay.textContent='Play'; return; }
    cplay.textContent = 'Pause';
    ctimer = setInterval(() => {
      if(ci >= +el('cmpscrub').max){ clearInterval(ctimer); ctimer=null;
        cplay.textContent='Play'; return; }
      ci++; drawCompare();
    }, 700);
  };
  drawCompare();
}

// Path split at each S, so the moves belonging to each switch read separately
// instead of running together in one string. Tolerates a list as well as a
// string: older run.json files stored the solver's raw command list.
const PATH = Array.isArray(RUN.path) ? RUN.path.join('') : (RUN.path || '');
el('pathbox').innerHTML = PATH
  ? PATH.split('S').map((seg, n) => `<span class="seg"><b>${n}</b>${seg || '—'}</span>`)
        .join('<span class="sw">S</span>')
  : '<span class="muted">no path</span>';

// ── one thumbnail per switch ──
el('turns').innerHTML = RUN.turns.map(t => {
  const isA = t.label === LAB.a;
  const a = isA ? t.to : t.stationary, b = isA ? t.stationary : t.to;
  const svg = board(G.walls, G.rows, G.cols, a, b, RUN.meta.n,
                    {cell:30, path: t.waypoints, hits: t.hits, ghost: t.from, mover: t.to,
                     color: isA ? 'var(--arrow-a)' : 'var(--arrow-b)',
                     color2: isA ? 'var(--a)' : 'var(--b)'});
  return `<figure class="cell" style="margin:0">${svg}
    <figcaption>switch ${String(t.layer).padStart(2,'0')} · ${t.label}<br>
    <span class="seg">${t.moves || '—'}</span></figcaption></figure>`;
}).join('') || '<span class="muted">no transitions</span>';

// ── recipes: table, thumbnails, and a player for the one you pick ──
// The whole section is hidden when the run had no recipes, so a plain solve
// does not show an empty heading.
if(!RUN.recipes.length){
  for(const id of ['rhead','rhint','recipes','rplayer']) el(id).style.display = 'none';
} else {
  const playable = RUN.recipes.filter(r => r.sequence && r.grid);
  if(!playable.length) el('rhint').style.display = 'none';

  // The full breakdown: how many walls each rule took, before/after, and the
  // percentage — so the table explains a result rather than just scoring it.
  el('recipes').innerHTML =
   `<table><tr><th>recipe</th><th>walls before</th><th>walls after</th>
      <th>untouched</th><th>thinned</th><th>uncrossable</th><th>cropped</th>
      <th>total removed</th><th>switches</th><th>status</th><th>page</th></tr>` +
   RUN.recipes.map((r, n) => {
     if(r.error)
       return `<tr><td>${r.mode??'?'}</td><td colspan="10" class="bad">ERROR: ${r.error}</td></tr>`;
     const st = r.preserved ? '<span class="ok">PRESERVED</span>'
                            : '<span class="bad">FAILED</span>';
     const pct = r.walls_before ? (100*(r.removed||0)/r.walls_before).toFixed(1) : '0.0';
     const pick = (r.sequence && r.grid) ? ` class="pick" data-r="${n}"` : '';
     const note = r.note ? `<div class="muted" style="white-space:normal">${r.note}</div>` : '';
     // Its own page, if the recipe produced one. Stop the click so opening the
     // link does not also load the inline player underneath.
     const link = r.report_href
       ? `<a href="${r.report_href}" onclick="event.stopPropagation()">open &rarr;</a>`
       : '<span class="muted">—</span>';
     return `<tr${pick}><td>${r.mode??'?'}${note}</td>
       <td>${r.walls_before??'-'}</td><td>${r.walls_after??'-'}</td>
       <td>${r.removed_untouched??'-'}</td><td>${r.removed_thinned??'-'}</td>
       <td>${r.removed_uncrossable??'-'}</td>
       <td>${r.removed_cropped??'-'}</td>
       <td>${r.removed??'-'} (${pct}%)</td>
       <td>${r.new_switches??'-'} / ${RUN.meta.switches}</td><td>${st}</td>
       <td>${link}</td></tr>`;
   }).join('') + `</table><div class="strip" style="margin-top:12px">` +
   RUN.recipes.filter(r => r.grid).map(r =>
     `<figure class="cell" style="margin:0">
        ${board(r.grid.walls, r.grid.rows, r.grid.cols, null, null, RUN.meta.n, {cell:26})}
        <figcaption>${r.mode} · ${r.walls_after} walls</figcaption></figure>`).join('') + `</div>`;

  // Clicking a solvable recipe plays its own solution in place, so the
  // simplified runs are browsable here rather than in a folder of images.
  el('recipes').querySelectorAll('tr.pick').forEach(row => {
    row.onclick = () => {
      const r = RUN.recipes[+row.dataset.r];
      el('recipes').querySelectorAll('tr').forEach(t => t.classList.remove('on'));
      row.classList.add('on');
      const pct = r.walls_before
        ? (100*(r.walls_before - r.walls_after)/r.walls_before).toFixed(1) : '0.0';
      const verdict = r.preserved
        ? `<span class="ok">PRESERVED</span> — switch count unchanged at ${RUN.meta.switches}`
        : `<span class="bad">FAILED</span> — switches moved `
          + `${RUN.meta.switches} → ${r.new_switches}, so a removed wall was load-bearing`;
      el('rplayer').innerHTML =
        `<h3 style="font-size:14px;margin:18px 0 4px">${r.mode} — `
        + `${r.walls_before}→${r.walls_after} walls (−${pct}%)</h3>`
        + `<p class="muted" style="margin:0 0 10px">${verdict}</p>`
        + `<h4 style="font-size:13px;margin:18px 0 6px">Its solution</h4>`;
      const host = document.createElement('div');
      el('rplayer').appendChild(host);
      makePlayer(host, r.grid, switchSteps(r.sequence), RUN.meta.n, 40);
    };
  });
}
</script>
